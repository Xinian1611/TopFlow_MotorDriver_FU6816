 233   2          }
 234   1          
 235   1          if (ReadBit(TIM3_CR1, T3IP))//周期中断
 236   1          {
 237   2              if (mcPwmInput.isUpdate == 0) // 空闲状态下  允许更新DR与ARR
 238   2              {
 239   3                  mcPwmInput.TimerDR            = TIM3__DR;
 240   3                  mcPwmInput.TimerARR           = TIM3__ARR;
 241   3                  mcPwmInput.isUpdate           = 1;
