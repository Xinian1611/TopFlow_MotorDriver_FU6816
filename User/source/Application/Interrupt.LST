 189          void CAN_INT(void)  interrupt 8
 190          {
 191   1          g_can_ifrLast = CAN_IFR;                                /* 【调试】中断标志快照（本 ISR �
             -�逐个清掉）*/
 192   1          if (ReadBit(CAN_IFR, RXIF))                             //接收中断
 193   1          {
 194   2                      CAN_Read();
 195   2              SetBit(CAN_CR1, BUFRLS);
 196   2          }
 197   1          
 198   1          if (ReadBit(CAN_IFR, TXIF))                             //发送成功中断
 199   1          {
 200   2              ClrBit(CAN_IFR, TXIF);
 201   2          }
 202   1          
 203   1          if (ReadBit(CAN_IFR, OVIF))                             //溢出中断
 204   1          {
 205   2              ClrBit(CAN_IFR, OVIF);
 206   2              g_can_ovifCnt++;                                    /* 【调试】接收溢出 */
 207   2          }
 208   1          
 209   1          if (ReadBit(CAN_IFR, ARBIF))                           //仲裁中断
 210   1          {
 211   2              ClrBit(CAN_IFR, ARBIF);
 212   2              g_can_arbCnt++;                                     /* 【调试】仲裁丢失 */
 213   2          }
 214   1          
 215   1          if (ReadBit(CAN_IFR, ERRIF))                           //错误类型中断
 216   1          {
 217   2              ClrBit(CAN_IFR, ERRIF);
 218   2              g_can_errCnt++;                                     /* 【调试】错误中断 */
 219   2          }
 220   1      }
