 249   1          {
 250   2              if (mcPwmInput.isUpdate == 0)   // 空闲状态下  允许更新DR与ARR
 251   2              {
 252   3                  if (ReadBit(P1, PIN1))      // PWM 100%输出
 253   3                  {
 254   4                      mcPwmInput.TimerDR       = 4000;
 255   4                      mcPwmInput.TimerARR      = 4000;
 256   4                  }
 257   3                  else//PWM 为0%
 258   3                  {
 259   4                      mcPwmInput.TimerDR       = 0;
 260   4                      mcPwmInput.TimerARR      = 4000;
 261   4                  }
 262   3                  
 263   3                  mcPwmInput.isUpdate = 1;
 264   3              }
 265   2              
 266   2              ClrBit(TIM3_CR1, T3IF);
 267   2          }
 268   1      }
