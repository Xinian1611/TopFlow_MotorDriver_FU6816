 178          /// @brief 设置电机目标值(正数正转, 负数反转)
 179          /// @param current 目标电流原始值：段字节13-14，0.01A 单位，零点 32767（无符号）
 180          /// @param speed   目标转速原始值：段字节11-12，0.01% 单位，零点 32767（无符号）
 181          /// @note  ★收的是协议"原始值"，两个要点：
 182          ///        ① 必须无符号读(EXT_GET_U16)。零点 32767、范围 ±100%(±10000 counts)，
 183          ///           正数 raw 一定 >32767（最高位=1）；有符号读会把正转变成大负数。
 184          ///        ② 换算要在这里做完：值 = raw - 32767（带符号）；
 185          ///           转速模式 → 值/10000 = 比例 → ×MOTOR_SPEED_BASE = rpm；
 186          ///           电流模式 → 值/100 = A。
 187          ///           因为 g_run_state.ref 的单位是 rpm / A
 188          ///           （TargetRef_Process 里用 S_Value()/I_Value()，它们期望的正是 rpm/A），
 189          ///           若把 0.01% 的原始值直接塞进 ref，S_Value() 会溢出（int16）。
 190          /// @retval None
 191          void MotorCtrl_SetTarget(uint16_t current, uint16_t speed)
 192          {
 193   1          int32 v;
 194   1          float ref_val;
 195   1      
 196   1          // 根据工作模式和控制状态设置电机参数
 197   1          if (g_run_state.is_started && !g_run_state.is_estop)
 198   1          {
 199   2              if (g_run_state.work_mode == EXT_WORK_MODE_SPEED)
 200   2              {
 201   3                  v = (int32)speed - 32767;                            /* 0.01% 单位，带符号 */
 202   3      
 203   3                  if (v >= 0)
 204   3                  {
 205   4                      g_run_state.direction = CW;                        // 正数正转
 206   4                      ref_val = (float)v;
 207   4                  }
 208   3                  else
 209   3                  {
 210   4                      g_run_state.direction = CCW;                       // 负数反转
 211   4                      ref_val = (float)(-v);                             // 存储绝对值
 212   4                  }
 213   3      
 214   3                  g_run_state.ref = ref_val / 10000.0f * MOTOR_SPEED_BASE;   /* 0.01% → 比例 → rpm */
 215   3      
 216   3                  if (v == 0)
 217   3                  {
 218   4                      g_run_state.is_started = 0;                        /* 目标 0% → 自动停机 */
 219   4                  }
 220   3              }
 221   2              else if (g_run_state.work_mode == EXT_WORK_MODE_CURRENT)
 222   2              {
 223   3                  v = (int32)current - 32767;                          /* 0.01A 单位，带符号 */
 224   3      
 225   3                  if (v >= 0)
 226   3                  {
 227   4                      g_run_state.direction = CW;                        // 正数正转
 228   4                      ref_val = (float)v;
 229   4                  }
 230   3                  else
 231   3                  {
 232   4                      g_run_state.direction = CCW;                       // 负数反转
 233   4                      ref_val = (float)(-v);                             // 存储绝对值
 234   4                  }
 235   3      
 236   3                  g_run_state.ref = ref_val / 100.0f;                    /* 0.01A → A */
 237   3      
 238   3                  if (v == 0)
C51 COMPILER V9.60.7.0   MOTORUSERCONTROL                                                  10/13/2026 17:38:34 PAGE 5   

 239   3                  {
 240   4                      g_run_state.is_started = 0;
 241   4                  }
 242   3              }
 243   2          }
 244   1      }
