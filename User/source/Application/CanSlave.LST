  68   1          g_tx_count++;
  69   1          return 1;
  70   1      }
  71          
  72          static uint8_t tx_queue_pop(uint32_t *can_id, uint8_t *dat)
  73          {
  74   1          if (g_tx_count == 0) return 0;
  75   1          *can_id = g_tx_queue[g_tx_head].can_id;
  76   1          memcpy(dat, g_tx_queue[g_tx_head].dat, CAN_FRAME_DATA_LEN);
