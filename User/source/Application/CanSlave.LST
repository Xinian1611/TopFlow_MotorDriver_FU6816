 519          /* ==================== 【调试用】协议层状态打印 ====================
 520           * 由 main.c 大循环每 500ms 调一次。printf 阻塞，禁止放进中断 / 1ms 任务。
 521           * 硬件/寄存器层的计数见 CAN.c 的 CAN_DebugPrint()。
 522           *
 523           * 与 CAN_DebugPrint() 配合分诊（从头往后看，哪一步断了就是哪一层的问题）：
 524           *   [CAN] rx 涨  → 硬件收到了帧
 525           *   [CAN] pop 涨 → 1ms 任务把它从环形缓冲取出来了
 526           *   [CAN-S] in 涨      → 帧进了协议层
 527           *   [CAN-S] cmd 涨     → 被当成指令报文处理了（CAN 链路到此为止全程正常）
 528           *   cmd 涨但电机不动   → 问题在指令解析 / 控制层，跟 CAN 无关
 529           */
 530          void ext_slave_debug_print(void)
 531          {
 532   1          /* --- 接收 ------------------------------------------------------------------------
 533   1           * in   = g_dbg_rxTotal    : 进入 ext_slave_process_rx() 的帧数
 534   1           *                           （= CAN_MsgParse 出队、且 CAN_IDE 判定为扩展帧）
 535   1           *                           正常：跟 [CAN] pop 同步涨
 536   1           *                           若 [CAN] pop 在涨而 in 不涨 => CAN_MsgParse 里 IDE 判断没进
 537   1           *                           （收到的帧被当成标准帧丢了），去看 [CAN] 那行的 ide �
             -��段
 538   1           * bad  = g_dbg_rxBad      : len!=8 或 dat==NULL 被丢弃的帧数
 539   1           *                           正常 0；不为 0 说明主机发的 DLC 不是 8
 540   1           * filt = g_dbg_rxFiltered : 被地址过滤丢掉的帧数，两种情况都会算进来：
 541   1           *                             ① 主类别/副类别与本机不符，或 设备号既不是本机�
             -�不是 0(广播)
 542   1           *                             ② msg_num == 0（非法帧号）
 543   1           *                           正常 0；涨而 cmd 不涨 => 主机的 ID 和本机地址对不上，
C51 COMPILER V9.60.7.0   CANSLAVE                                                          10/13/2026 19:02:13 PAGE 10  

 544   1           *                           本机地址在 main.c 的 ext_cfg：sys=0 / 主类别=11 / 副类别=15 
             -/ 设备号=1
 545   1           *                           （设备号填 0 表示广播，也会被接收）
 546   1           * cmd  = g_dbg_rxCmd      : 判定为指令报文(pri=2)并进入 ext_process_cmd_message() 的帧数
 547   1           *                           正常：跟 in 同步涨
 548   1           *                           ★注意：这里只统计"进入了指令处理函数"，
 549   1           *                             并不保证没被里面的调试钩子(db g_cmd)吞掉
 550   1           * -------------------------------------------------------------------------------------- */
 551   1          printf("[CAN-S] in=%u bad=%u filt=%u cmd=%u\r\n",
 552   1                 g_dbg_rxTotal, g_dbg_rxBad, g_dbg_rxFiltered, g_dbg_rxCmd);
 553   1      
 554   1          /* --- 发送队列 + 三个上报节拍（实参统一 (uint16) + %u，st 是 uint8_t 必须显式转
             -）------------
 555   1           * txQ = g_tx_count          : 发送队列里还没发出去的帧数（每 1ms 弹 1 帧发）
 556   1           *                             正常 0~2；持续 >5 说明入队快于出队，或 CAN_Send 被卡�
             -�
 557   1           * hb  = g_ext_heartbeat_cnt : 心跳节拍计数，满 500 发一帧心跳。取值 0~499
 558   1           *                             ★打印本身就是"每 500 次 1ms 调一次"，
 559   1           *                               所以打印时刻它恒为 0 —— 这是正常的，不是故障
 560   1           * st  = g_ext_status_cnt    : 状态节拍计数(uint8)，满 150 发一帧状态。取值 0~149
 561   1           *                             打印时刻会呈 0 / 50 / 100 循环（每次 +500 对 150 取模）
 562   1           * lg  = g_ext_log_cnt       : 日志节拍计数，满 1100 发一帧日志(4 帧)。取值 0~1099
 563   1           *                             打印时刻每次 +500（对 1100 取模）
 564   1           * 三个节拍只要在持续变化 = 1ms 任务(TickCycle_1ms)在正常跑；
 565   1           * 若连续多行完全不动 => 1ms 任务停了（主循环卡住 / 看门狗复位）
 566   1           * -------------------------------------------------------------------------------------- */
 567   1          printf("[CAN-S] txQ=%u hb=%u st=%u lg=%u\r\n",
 568   1                 (uint16)g_tx_count, g_ext_heartbeat_cnt, (uint16)g_ext_status_cnt, g_ext_log_cnt);
 569   1      
 570   1          /* --- 配置报文多帧组装状态 ----------------------------------------------------------------
             ---
 571   1           * asmR = g_ext_asm.received : 正在组装的配置报文的"已收帧位图"
 572   1           *                             （bit0=第1帧、bit1=第2帧…配置报文共 11 帧=bit0~bit10）
 573   1           *                             正常 0（没在组装）；非 0 = 主机正在下发 11 帧配置报
             -文，
 574   1           *                             500ms 内没收齐会被整体丢弃（asmR 归 0）
 575   1           * -------------------------------------------------------------------------------------- */
 576   1          printf("[CAN-S] asmR=%u\r\n", (uint16)g_ext_asm.received);
 577   1      
 578   1          /* ★ 新增三个探针（用来定位"状态帧 Byte0 为什么会跳"）：
