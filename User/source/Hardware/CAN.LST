 503   1          printf("[CAN] CR0=%u SR=%u CR1=%u IFR=%u\r\n",
 504   1                 (uint16)CAN_CR0, (uint16)CAN_SR, (uint16)CAN_CR1, (uint16)CAN_IFR);
 505   1      
 506   1          /* --- 配置回读 + 发送错误计数 -------------------------------------------------------------
