 513   1                 (uint16)CAN_IER, (uint16)CAN_BTR1, (uint16)CAN_BTR2, (uint16)CAN_TEC);
 514   1      
 515   1          /* --- 接收侧错误 + 引脚状态 ----------------------------------------------------------------
