 599   1                 (uint16)P0, (uint16)CAN_CR0, (uint16)CAN_SR, (uint16)CAN_CR1);
 600   1          printf("[ST] IFR=%u IER=%u TEC=%u REC=%u\r\n",
 601   1                 (uint16)CAN_IFR, (uint16)CAN_IER, (uint16)CAN_TEC, (uint16)CAN_REC);
 602   1      
 603   1          /* 开自发自收 + 禁止自动重传：这样不需要总线上有第二个节点来 ACK */
 604   1          SetBit(CAN_CR1, TXSELF);
 605   1          SetBit(CAN_CR1, NOART);
 606   1      
 607   1          /* ② A：保持当前配置（RSTMOD=0）试一次
