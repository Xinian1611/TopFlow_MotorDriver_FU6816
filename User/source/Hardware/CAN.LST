 630          /* ==================== 【调试用】CAN 引脚 / 收发器 连通性探针 ====================
 631           * 原理：如果收发器确实接在 CANTX/CANRX 上，那么我们发帧时它会把总线状态回送
             -到 RXD，
 632           *       于是采样 CANRX 能看到"显性=低"电平；若发帧期间 CANRX 一直是高，
 633           *       说明这两根脚上没有收发器（或收发器没供电/没使能）。
 634           *
C51 COMPILER V9.60.7.0   CAN                                                               10/13/2026 17:38:34 PAGE 12  

 635           * 判读：
 636           *   txLow>0 且 rxLow>0  => 两脚 + 收发器都通，问题在总线/主机侧（接线、120Ω 终端�
             -��主机没发）
 637           *   txLow>0 且 rxLow=0  => 收发器不在这一对脚上（或没供电）
 638           *   txLow=0             => CANTX 引脚压根没被驱动
 639           *
 640           * 下面两个开关按探针结果翻：
 641           */
 642          /* ★ txLow=0 时改成 1：给 P0.0 加输出使能再探一次 */
 643          #define CAN_DEBUG_SET_P00_OE     0
 644          /* ★ txLow>0 且 rxLow=0 时改成 1：换到 CAN_CH=1（P0.5/P0.6）再探一次，
 645           *   验证收发器是不是接在那一对脚上。注意 P0.5/P0.6 同时是调试串口，
 646           *   探针期间会临时摘掉 UART1 复用，探完恢复。*/
 647          #define CAN_DEBUG_PROBE_CH1      0
 648          
 649          /* 发一帧，同时高频采样：CANTX/CANRX 引脚上出现的"显性(低)"次数 + TXING 持续时间
             - */
 650          static void CAN_SendAndSample(uint8 txMask, uint8 rxMask, uint16 *txLow, uint16 *rxLow, uint16 *txing)
 651          {
 652   1          uint16 i;
 653   1          uint8  dat[8];
 654   1      
 655   1          memset(dat, 0x55, 8);               /* 0x55 = 显性/隐性交替，便于观察 */
 656   1      
 657   1          CanSend.CAN_IDE = IDE_EXT;
 658   1          CanSend.CAN_RTR = RTR_DAT;
 659   1          CanSend.CAN_DLC = CAN_FRAME_DATA_LEN;
 660   1          CanSend.EXTID   = 0x12345678UL;
 661   1          memcpy(&CanSend.Data0, dat, CAN_FRAME_DATA_LEN);
 662   1      
 663   1          *txLow = 0;
 664   1          *rxLow = 0;
 665   1          *txing = 0;
 666   1      
 667   1          CAN_Send();
 668   1      
 669   1          /* 采样约 10ms。一帧 8 字节 @250kbps 约 0.5ms，所以：
 670   1           *   正常"发一帧就完"          => txing 约占 5%~15%（几千分之几百）
 671   1           *   没人 ACK + 自动重传       => TXING 一直不清 => txing 接近 10000
 672   1           * 这个数直接说明"总线对端到底有没有在应答我们"。
