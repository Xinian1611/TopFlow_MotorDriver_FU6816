 675   1          {
 676   2              if ((P0 & txMask) == 0) (*txLow)++;
 677   2              if ((P0 & rxMask) == 0) (*rxLow)++;
 678   2              if (ReadBit(CAN_SR, TXING)) (*txing)++;
 679   2          }
 680   1      }
