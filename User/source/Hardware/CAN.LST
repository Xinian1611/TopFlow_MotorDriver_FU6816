 611   1                 (uint16)r0, (uint16)Can.CAN_IDE, (uint16)CAN_SR, (uint16)CAN_IFR);
 612   1          printf("[ST] A ext=%lx std=%lx\r\n", Can.EXTID, Can.STDID);
 613   1      
 614   1          /* ③ B：把 RSTMOD 置 1 再试一次 */
 615   1          cr0_save = CAN_CR0;
 616   1          SetBit(CAN_CR0, RSTMOD);
 617   1          r1 = CAN_LoopbackOnce();
 618   1          printf("[ST] B RSTMOD1 rx=%u id=%lx SR=%u IFR=%u\r\n",
 619   1                 (uint16)r1, Can.EXTID, (uint16)CAN_SR, (uint16)CAN_IFR);
 620   1      
 621   1          /* ④ 恢复原状，后面按正常流程跑 */
 622   1          CAN_CR0 = cr0_save;
 623   1          ClrBit(CAN_CR1, TXSELF);
 624   1          ClrBit(CAN_CR1, NOART);
 625   1          ClrBit(CAN_CR1, TXREQ);             /* 清掉自检残留的发送请求 */
