  98          void CAN_detect(void)
  99          {
 100   1        if(ReadBit(CAN_IFR, RXIF))
 101   1        {
 102   2          CAN_Read();
 103   2          SetBit(CAN_CR1, BUFRLS);     /* 轮询模式必须手动释放接收缓冲 */
 104   2        }
 105   1        if(ReadBit(CAN_IFR, TXIF))  ClrBit(CAN_IFR, TXIF);
 106   1        if(ReadBit(CAN_IFR, ERRIF)) ClrBit(CAN_IFR, ERRIF);
 107   1      }
