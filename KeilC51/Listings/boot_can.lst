   3          /*------------------------------------------------------------------------------------
   4          函数功能：boot 的 CAN 初始化（250k，标准帧，全通滤波，不开中断）
   5          输入参数：无
   6          返回参数：无
   7          特别说明：boot 阶段 EA 必须为 0，只能轮询；参数照搬 APP 的 CAN.c
   8          ------------------------------------------------------------------------------------*/
   9          void CAN_Init(void)
  10          {
  11   1        uint16 BRP  = 11;               /* 24MHz / (12*8) = 250k */
  12   1        uint8  SEG1 = 5;
  13   1        uint8  SEG2 = 0;
  14   1      
  15   1        CAN_BTR0 = 0;
  16   1        CAN_BTR1 = 0;
  17   1        CAN_BTR2 = 0;
  18   1        CAN_BTR0 |= (uint8)(BRP >> 8);
  19   1        CAN_BTR1  = (uint8)BRP;
  20   1        CAN_BTR2 |= (uint8)((SEG2 << 4) | SEG1);
  21   1      
  22   1        SetBit(CAN_CR0, FILMOD);        /* 单滤波 */
  23   1        CAN_FIR0 = 0; CAN_FIR1 = 0; CAN_FIR2 = 0; CAN_FIR3 = 0;
  24   1        CAN_FMR0 = 0xFF;                /* 屏蔽位全 1 = 全不关心，标准/扩展都收 */
  25   1        CAN_FMR1 = 0xFF;
  26   1        CAN_FMR2 = 0xFF;
  27   1        CAN_FMR3 = 0xFF;
  28   1      
  29   1        CAN_IER = 0;                    /* 不开任何中断 */
  30   1        ClrBit(CAN_CR0, RSTMOD);
  31   1        ClrBit(CAN_CR0, CAN_CH);        /* 锁死 P0.0/P0.1 */
  32   1        SetBit(CAN_CR0, CANEN);
  33   1      }
