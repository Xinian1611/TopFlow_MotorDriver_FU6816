                      /*外部中断 INT0 接口选择
                      000: P0.0
                      001: P0.1
                      010: P0.2
                      011: P0.3
                      100: P1.1
                      101: P0.5
                      110: P0.6*/
                      ClrBit(LVSR, EXT0CFG2);             
                      ClrBit(LVSR, EXT0CFG1);
