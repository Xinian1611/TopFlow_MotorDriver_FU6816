  42   1              ClrBit(P1_OE, P11);                     // 配置为输入
  43   1              ClrBit(P1_IF, P11);                     // clear P11 interrupt flag
  44   1              ClrBit(P1_IE, P11);                     // config P11 as the source of EXTI1
  45   1              IT11 = 1;
  46   1              IT10 = 0;                               // 00: posedge mode interrupt，01: negedge mode interrupt
