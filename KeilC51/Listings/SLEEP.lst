                      SetBit(IP0, PX01);
                      SetBit(IP0, PX00);                      // 外部中断0中断优先级别3，中断优先级最�
             -�
                      EX0 = 1;                                // 使能外部中断0, P01位于外部中断输入硬件
                      EA = 1;                                 // 使能全局中断
                  #endif
  41   1        #if ((LIN_PORTSELECTION == TXDGP10_RXDGP11) ||(LIN_TRANSCEIVER == INNER_LIN_SINGLELINE))//配置唤醒口
