 185          /* ---------------------------------------------------------------------
 186           * 任意长度连续写：按 64 字节页边界自动拆分为多次页写
 187           *   输入：addr 起始地址(0x0000~0x7FFF)，len 长度(1~32KB)，buf 数据指针
 188           *   返回：EEPROM_OK 成功；EEPROM_ERR_PARAM 参数错误；其余=驱动层硬件错误码
 189           * 说明：驱动层 EEPROM_HwWritePage 每次写事务后已含写周期 ACK 轮询与
 190           *       5ms 写周期尾延时，逐页写互不影响，写后立即读可靠。
 191           * ------------------------------------------------------------------- */
 192          int16_t EEPROM_WriteBuffer(uint16_t addr, uint16_t len, const uint8_t *buf)
 193          {
 194   1          uint16_t chunk;
 195   1          int16_t ret;
 196   1      
 197   1          if ((len == 0) || (buf == 0) || ((uint32_t)addr + len > EEPROM_TOTAL_SIZE)) {
 198   2              return EEPROM_ERR_PARAM;
 199   2          }
 200   1      
 201   1          while (len > 0) {
 202   2              /* 本页剩余容量 = 页大小 - 页内偏移，取与剩余长度的较小值 */
 203   2              chunk = EEPROM_PAGE_SIZE - (addr % EEPROM_PAGE_SIZE);
 204   2              if (chunk > len) {
 205   3                  chunk = len;
 206   3              }
 207   2              ret = (int16_t)EEPROM_HwWritePage(addr, chunk, buf);
 208   2              if (EEPROM_OK != ret) {
 209   3                  return ret;   /* 原样返回驱动层错误码（1~6，区分失败阶段） */
 210   3              }
 211   2              addr += chunk;
 212   2              buf  += chunk;
 213   2              len  -= chunk;
 214   2          }
 215   1          return EEPROM_OK;
 216   1      }
