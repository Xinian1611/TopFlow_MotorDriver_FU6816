 248          /* ---------------------------------------------------------------------
 249           * 自检：器件在位 + 读写回环
 250           *   1. 器件在位检查（发写器件地址等 ACK）
 251           *   2. 对自检测试地址（0x6FF8，避开 0x0000 一键部署区与 0x6E00 测试区）：
 252           *      读原值 -> 写约定字节 -> 读回比对 -> 恢复原值 -> 读回确认恢复
 253           *   返回：EEPROM_OK 通过；其余为失败阶段码（1~6 硬件、7 回环不一致、8 恢复失�
             -�）
 254           * 说明：BL24C256A 无 0x7FFA 出厂 ID 区，不能沿用 GearBox 的
 255           *       “读 0x7FFA 比对 0x29/0x48”自检，回环验证同样可覆盖总线故障。
 256           * ------------------------------------------------------------------- */
 257          int16_t EEPROM_SelfCheck(void)
 258          {
 259   1          uint8_t old;
 260   1          uint8_t rd;
 261   1          int16_t ret;
 262   1      
 263   1          /* 1. 器件在位 */
 264   1          if (EEPROM_OK != EEPROM_Check()) {
 265   2              return EEPROM_ERR_DEV_ACK;
 266   2          }
 267   1      
 268   1          /* 2. 回环：读原值 */
 269   1          ret = EEPROM_ReadByte(EEPROM_SELFCHECK_ADDR, &old);
 270   1          if (EEPROM_OK != ret) {
 271   2              return ret;
 272   2          }
 273   1      
 274   1          /* 3. 写入约定字节 */
 275   1          ret = EEPROM_WriteByte(EEPROM_SELFCHECK_ADDR, EEPROM_SELFCHECK_MAGIC);
 276   1          if (EEPROM_OK != ret) {
 277   2              return ret;
 278   2          }
 279   1      
 280   1          /* 4. 读回比对 */
 281   1          ret = EEPROM_ReadByte(EEPROM_SELFCHECK_ADDR, &rd);
 282   1          if (EEPROM_OK != ret) {
 283   2              return ret;
 284   2          }
 285   1          if (EEPROM_SELFCHECK_MAGIC != rd) {
 286   2              return EEPROM_ERR_LOOPBACK;
 287   2          }
 288   1      
 289   1          /* 5. 恢复原值并确认 */
 290   1          ret = EEPROM_WriteByte(EEPROM_SELFCHECK_ADDR, old);
 291   1          if (EEPROM_OK != ret) {
 292   2              return EEPROM_ERR_RESTORE;
 293   2          }
 294   1          ret = EEPROM_ReadByte(EEPROM_SELFCHECK_ADDR, &rd);
 295   1          if (EEPROM_OK != ret) {
 296   2              return EEPROM_ERR_RESTORE;
C51 COMPILER V9.60.7.0   EEPROM                                                            10/20/2026 16:09:21 PAGE 6   

 297   2          }
 298   1          if (old != rd) {
 299   2              return EEPROM_ERR_RESTORE;
 300   2          }
 301   1      
 302   1          return EEPROM_OK;
 303   1      }


