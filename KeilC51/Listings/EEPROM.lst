 221          int16_t EEPROM_ReadBuffer(uint16_t addr, uint16_t len, uint8_t *buf)
 222          {
 223   1          if ((len == 0) || (buf == 0) || ((uint32_t)addr + len > EEPROM_TOTAL_SIZE)) {
 224   2              return EEPROM_ERR_PARAM;
 225   2          }
 226   1          return (int16_t)EEPROM_HwReadCore(addr, len, buf);
 227   1      }
