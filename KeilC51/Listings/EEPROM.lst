 142          /**
 143           * @brief  连续读公共实现（伪写寻址 + STOP 后重新起始读）
 144           * @note   不用重复 START：BL24C256A 对“写事务后紧跟的重复 START”响应异常
 145           *         （实测写后立即读回 0xFF，延时 50ms 后正常）；改为伪写寻址以 STOP
 146           *         完整结束事务（从机回 standby）后重新 START 发起“当前地址读”，
 147           *         协议兼容性更好。
 148           */
 149          static int16_t  EEPROM_HwReadCore(uint16_t addr, uint16_t len, uint8_t *buf)
 150          {
 151   1          int16_t  ret;
 152   1          uint16_t i;
 153   1      
 154   1          SoftI2C_Start();
 155   1          SoftI2C_SendByte(EEPROM_DEV_ADDR_W);
 156   1          if (SoftI2C_ReceiveACK()) { ret = EEPROM_ERR_DEV_ACK; goto out; }
 157   1          SoftI2C_SendByte((uint8_t)(addr >> 8));
 158   1          if (SoftI2C_ReceiveACK()) { ret = EEPROM_ERR_ADDRH; goto out; }
 159   1          SoftI2C_SendByte((uint8_t)(addr & 0xFF));
 160   1          if (SoftI2C_ReceiveACK()) { ret = EEPROM_ERR_ADDRL; goto out; }
 161   1      
 162   1          /* 伪写寻址 STOP 结束（从机回 standby），延时后重新 START + 读器件地址 */
 163   1          SoftI2C_Stop();
 164   1          delay_us(500);
 165   1      
 166   1          SoftI2C_Start();
 167   1          SoftI2C_SendByte(EEPROM_DEV_ADDR_R);
 168   1          if (SoftI2C_ReceiveACK()) { ret = EEPROM_ERR_DEV_ACK; goto out; }
 169   1      
 170   1          /* 前 len-1 字节收 ACK，最后一字节收 NACK 后停止 */
 171   1          for (i = 0; i < len - 1; i++) {
 172   2              buf[i] = SoftI2C_ReceiveByte();
 173   2              SoftI2C_SendACK();
C51 COMPILER V9.60.7.0   EEPROM                                                            10/20/2026 16:09:21 PAGE 4   

 174   2          }
 175   1          buf[len - 1] = SoftI2C_ReceiveByte();
 176   1          SoftI2C_SendNoACK();
 177   1          SoftI2C_Stop();
 178   1          return EEPROM_OK;
 179   1      
 180   1      out:
 181   1          SoftI2C_Stop();
 182   1          return ret;
 183   1      }
