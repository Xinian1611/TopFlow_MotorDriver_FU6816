 190           */
 191          void CAN_INT(void)  interrupt 8
 192          {
 193   1          g_can_ifrLast = CAN_IFR;                                /* 【调试】中断标志快照（本 ISR �
             -�逐个清掉）*/
 194   1          if (ReadBit(CAN_IFR, RXIF))                             //接收中断
 195   1          {
 196   2          CAN_Read();
 197   2              SetBit(CAN_CR1, BUFRLS);
 198   2          }
 199   1          
 200   1          if (ReadBit(CAN_IFR, TXIF))                             //发送成功中断
 201   1          {
 202   2              ClrBit(CAN_IFR, TXIF);
 203   2          }
 204   1          
 205   1          if (ReadBit(CAN_IFR, OVIF))                             //溢出中断
 206   1          {
 207   2              ClrBit(CAN_IFR, OVIF);
 208   2              g_can_ovifCnt++;                                    /* 【调试】接收溢出 */
 209   2          }
 210   1          
 211   1          if (ReadBit(CAN_IFR, ARBIF))                           //仲裁中断
 212   1          {
 213   2              ClrBit(CAN_IFR, ARBIF);
 214   2              g_can_arbCnt++;                                     /* 【调试】仲裁丢失 */
 215   2          }
 216   1          
 217   1          if (ReadBit(CAN_IFR, ERRIF))                           //错误类型中断
 218   1          {
 219   2              ClrBit(CAN_IFR, ERRIF);
 220   2              g_can_errCnt++;                                     /* 【调试】错误中断 */
 221   2          }
 222   1      }
