 219          /** 
 220           * @brief        定时器3中断服务函数
 221           * @note         本例程中用于PWM调速信号捕获
 222           * @date         2022-07-14
 223           */
 224          void TIM3_INT(void) interrupt 9
 225          {
 226   1          if (ReadBit(TIM3_CR1, T3IR))
 227   1          {
 228   2              ClrBit(TIM3_CR1, T3IR);
 229   2          }
 230   1          
 231   1          if (ReadBit(TIM3_CR1, T3IP))//周期中断
 232   1          {
 233   2              if (mcPwmInput.isUpdate == 0) // 空闲状态下  允许更新DR与ARR
C51 COMPILER V9.60.7.0   INTERRUPT                                                         09/21/2026 17:11:29 PAGE 5   

 234   2              {
 235   3                  mcPwmInput.TimerDR            = TIM3__DR;
 236   3                  mcPwmInput.TimerARR           = TIM3__ARR;
 237   3                  mcPwmInput.isUpdate           = 1;
 238   3                  SleepSet.SleepDelayCout = 0;    //有PWM信号清零
 239   3              }
 240   2              
 241   2              ClrBit(TIM3_CR1, T3IP);
 242   2          }
 243   1          
 244   1          if (ReadBit(TIM3_CR1, T3IF))
 245   1          {
 246   2              if (mcPwmInput.isUpdate == 0)   // 空闲状态下  允许更新DR与ARR
 247   2              {
 248   3                  if (ReadBit(P1, PIN1))      // PWM 100%输出
 249   3                  {
 250   4                      mcPwmInput.TimerDR       = 4000;
 251   4                      mcPwmInput.TimerARR      = 4000;
 252   4                  }
 253   3                  else//PWM 为0%
 254   3                  {
 255   4                      mcPwmInput.TimerDR       = 0;
 256   4                      mcPwmInput.TimerARR      = 4000;
 257   4                  }
 258   3                  
 259   3                  mcPwmInput.isUpdate = 1;
 260   3              }
 261   2              
 262   2              ClrBit(TIM3_CR1, T3IF);
 263   2          }
 264   1      }
