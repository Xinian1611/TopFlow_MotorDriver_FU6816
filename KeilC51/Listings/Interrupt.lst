 235   2          }
 236   1          
 237   1          if (ReadBit(TIM3_CR1, T3IP))//周期中断
 238   1          {
 239   2              if (mcPwmInput.isUpdate == 0) // 空闲状态下  允许更新DR与ARR
 240   2              {
 241   3                  mcPwmInput.TimerDR            = TIM3__DR;
 242   3                  mcPwmInput.TimerARR           = TIM3__ARR;
 243   3                  mcPwmInput.isUpdate           = 1;
 244   3                  SleepSet.SleepDelayCout = 0;    //有PWM信号清零
 245   3              }
 246   2              
 247   2              ClrBit(TIM3_CR1, T3IP);
 248   2          }
 249   1          
 250   1          if (ReadBit(TIM3_CR1, T3IF))
 251   1          {
 252   2              if (mcPwmInput.isUpdate == 0)   // 空闲状态下  允许更新DR与ARR
 253   2              {
 254   3                  if (ReadBit(P1, PIN1))      // PWM 100%输出
 255   3                  {
 256   4                      mcPwmInput.TimerDR       = 4000;
 257   4                      mcPwmInput.TimerARR      = 4000;
 258   4                  }
 259   3                  else//PWM 为0%
 260   3                  {
 261   4                      mcPwmInput.TimerDR       = 0;
 262   4                      mcPwmInput.TimerARR      = 4000;
 263   4                  }
 264   3                  
 265   3                  mcPwmInput.isUpdate = 1;
 266   3              }
 267   2              
 268   2              ClrBit(TIM3_CR1, T3IF);
 269   2          }
 270   1      }
