 189          void CAN_INT(void)  interrupt 8
 190          {
 191   1          if (ReadBit(CAN_IFR, RXIF))                             //接收中断
 192   1          {
 193   2          CAN_Read();
 194   2              SetBit(CAN_CR1, BUFRLS);
 195   2          }
 196   1          
 197   1          if (ReadBit(CAN_IFR, TXIF))                             //发送成功中断
 198   1          {
 199   2              ClrBit(CAN_IFR, TXIF);
 200   2          }
 201   1          
 202   1          if (ReadBit(CAN_IFR, OVIF))                             //溢出中断
 203   1          {
 204   2              ClrBit(CAN_IFR, OVIF);
 205   2          }
 206   1          
 207   1          if (ReadBit(CAN_IFR, ARBIF))                           //仲裁中断
 208   1          {
 209   2              ClrBit(CAN_IFR, ARBIF);
 210   2          }
 211   1          
 212   1          if (ReadBit(CAN_IFR, ERRIF))                           //错误类型中断
 213   1          {
 214   2              ClrBit(CAN_IFR, ERRIF);
 215   2          }
 216   1      }
