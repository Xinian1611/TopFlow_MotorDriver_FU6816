 225          /** 
 226           * @brief        定时器3中断服务函数
 227           * @note         本例程中用于PWM调速信号捕获
 228           * @date         2022-07-14
 229           */
 230          void TIM3_INT(void) interrupt 9
 231          {
 232   1          if (ReadBit(TIM3_CR1, T3IR))
C51 COMPILER V9.60.7.0   INTERRUPT                                                         10/27/2026 17:50:52 PAGE 5   

 233   1          {
