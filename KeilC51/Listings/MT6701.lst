 157           *   (I2CSTA,I2CSTP)：00=数据字节  01=STOP  10=START+地址字节
 158           *   STR=1 = 上一动作完成且 SCL 被硬件拉低，清 STR 才释放并执行下一动作 */
 159          static uint8 mt_i2c_read(uint8 dev, uint8 reg, uint8 *buf, uint8 n)
 160          {
 161   1          uint8 i, r;
 162   1      
 163   1          if (mt_wait_idle() != 0) { return 3; }
 164   1          mt_flags_clr();
 165   1      
 166   1          /* --- 相位1：START + 地址(W)（总线空闲时，写 I2CSTA 即发出）--- */
 167   1          I2C_ID = (uint8)(dev << 1);               /* 0x0C；读写位由 DMOD 决定 */
