 168          /// @brief 设置电机目标值(正数正转, 负数反转)
 169          /// @param current 段字节13-14：0.01A，32767 = 0A
 170          /// @param speed   段字节11-12：0.01%，32767 = 0%，±10000 = ±100%
 171          /// @note  ① 必须按无符号收：正数 raw 一定 >32767，用 int16 会变成大负数；
 172          ///        ② 0% 只表示"目标 0"，停机由启停字段负责 —— 这里不再自动置 is_starte
             -d=0，
 173          ///           否则"起机+0% → 再给 20%"这种时序会让后面的速度全部不生效。
 174          /// @retval None
 175          void MotorCtrl_SetTarget(uint16_t current, uint16_t speed)
 176          {
C51 COMPILER V9.60.7.0   MOTORUSERCONTROL                                                  11/04/2026 11:32:03 PAGE 4   

 177   1          int32 v;
 178   1          float mag;
 179   1          float base;
 180   1          float idle;
 181   1      
 182   1          if (g_run_state.is_estop)
 183   1          {
 184   2              return;                                 /* 急停中不接受目标 */
 185   2          }
 186   1      
 187   1          if (g_run_state.work_mode == EXT_WORK_MODE_CURRENT)
 188   1          {
 189   2              v   = (int32)current - 32767;           /* 0.01A */
 190   2              mag = (v >= 0) ? (float)v : (float)(-v);
 191   2              g_run_state.direction = (v >= 0) ? CW : CCW;
 192   2              g_run_state.ref       = mag / 100.0f;   /* 0.01A → A */
 193   2      
 194   2          }
 195   1          else                                        /* 转速模式 */
 196   1          {
 197   2              v   = (int32)speed - 32767;             /* 0.01% */
 198   2              mag = (v >= 0) ? (float)v : (float)(-v);
 199   2              if (mag > 10000.0f) mag = 10000.0f;     /* 钳到 ±100% */
 200   2      
 201   2              g_run_state.direction = (v >= 0) ? CW : CCW;
 202   2      
 203   2              if (mag <= 0.0f)
 204   2              {
 205   3                  g_run_state.ref = 0.0f;             /* 0% = 停机 */
 206   3              }
 207   2              else
 208   2              {
 209   3                  /* 100% = 配置里的 max_speed */
 210   3                  base = (g_motor_cfg->max_speed != 0) ? (float)g_motor_cfg->max_speed
 211   3                                                       : MOTOR_SPEED_BASE;
 212   3                  /* 非零给定时的下限 = 配置里的 idle_speed(rpm) */
 213   3                  idle = (float)g_motor_cfg->idle_speed;
 214   3                  if (idle > base) idle = base;
 215   3      
 216   3                  /* 1%~100% → idle_speed ~ max_speed */
 217   3                  g_run_state.ref = idle + (base - idle) * (mag / 10000.0f);
 218   3              }
 219   2          }
 220   1      }
