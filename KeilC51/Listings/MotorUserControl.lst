 145          /// @brief 设置电机控制模式
 146          /// @param mode 闭环方式选择
 147          /// @retval None
 148          void MotorCtrl_SetMode(uint8_t mode)
 149          {
 150   1          // 检查模式是否有效
 151   1          if (mode < EXT_WORK_MODE_CURRENT || mode > EXT_WORK_MODE_SPEED)
 152   1              return;
 153   1      
 154   1          if (mode == g_run_state.work_mode)
 155   1              return;
 156   1      
 157   1          g_run_state.work_mode = mode;
 158   1          if (mode == EXT_WORK_MODE_SPEED)
 159   1          {
 160   2              MOTOR_CTRL_MODE = SPEED_LOOP_CONTROL;
 161   2          }
 162   1          else if (mode == EXT_WORK_MODE_CURRENT)
 163   1          {
 164   2              MOTOR_CTRL_MODE = CURRENT_LOOP_CONTROL;
 165   2          }
 166   1      }
