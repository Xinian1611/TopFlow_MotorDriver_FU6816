 126          /// @brief 设置电机运行状态
 127          /// @param state 0: 停止 1: 运行
 128          /// @retval None
 129          void MotorCtrl_SetRun(uint8_t state)
 130          {
 131   1          if (state == g_run_state.is_started)
 132   1              return;
 133   1      
 134   1          g_run_state.is_started = state;
 135   1      
 136   1          if (g_run_state.is_started == 0)
 137   1          {
 138   2              g_run_state.run_time = 0;
 139   2      
 140   2              g_run_state.ref              = 0.0f;   /* 停机撤给定，再起机必须重新下发速度 */
 141   2              g_run_state.reversal_braking = 0;
 142   2          }
 143   1      }
