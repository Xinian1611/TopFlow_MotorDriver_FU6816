 133          /// @brief 写入设备配置参数
 134          /// @param cfg 配置参数结构体指针
 135          /// @retval None
 136          void DevConfig_WriteParam(const void *cfg)
 137          {
 138   1          if (cfg == NULL)
 139   1              return;
 140   1      
 141   1          if (memcmp(&s_dev_cfg.motor_cfg, cfg, sizeof(MotorDrvCfg_t)) == 0)
 142   1              return;      /* 和当前配置一样 → 直接返回，不写盘 */
 143   1      
 144   1          s_dev_cfg.crc = DevConfig_CalcCRC((const uint8_t *)cfg, sizeof(MotorDrvCfg_t));
 145   1          memcpy(&s_dev_cfg.motor_cfg, cfg, sizeof(MotorDrvCfg_t));
 146   1      
 147   1          /* 96 字节跨页（0x0000~0x005F）：用自动分页的接口层，内部拆成 64 + 32 两次页�
             -� */
 148   1          (void)EEPROM_WriteBuffer(AT24CXX_CFG_ADDR, sizeof(DevConfig_t), (const uint8_t *)&s_dev_cfg);
 149   1      }
