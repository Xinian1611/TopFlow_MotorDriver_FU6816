 224          /******************************************************************************
 225           * CRC计算函数
 226           ******************************************************************************/
 227          
 228          /// @brief 计算配置参数CRC32校验码
 229          /// @param cfg 配置参数结构体指针
 230          /// @retval CRC32校验码
 231          static uint32_t DevConfig_CalcCRC(const uint8_t *dat, uint16_t len)
 232          {
 233   1          uint32_t crc = 0xFFFFFFFF;
 234   1          uint16_t i, j;
 235   1      
 236   1          for (i = 0; i < len; i++)
 237   1          {
 238   2              crc ^= (uint32_t)dat[i];
C51 COMPILER V9.60.7.0   DEVCONFIG                                                         10/27/2026 17:50:52 PAGE 5   

 239   2              for (j = 0; j < 8; j++)
 240   2              {
 241   3                  if (crc & 0x01)
 242   3                  {
 243   4                      crc = (crc >> 1) ^ 0xEDB88320;
 244   4                  }
 245   3                  else
 246   3                  {
 247   4                      crc >>= 1;
 248   4                  }
 249   3              }
 250   2          }
 251   1      
 252   1          return crc ^ 0xFFFFFFFF;
 253   1      }
