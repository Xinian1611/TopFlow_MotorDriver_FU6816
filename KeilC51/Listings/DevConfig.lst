 199          /******************************************************************************
 200           * CRC计算函数
 201           ******************************************************************************/
 202          
 203          /// @brief 计算配置参数CRC32校验码
 204          /// @param cfg 配置参数结构体指针
 205          /// @retval CRC32校验码
 206          static uint32_t DevConfig_CalcCRC(const uint8_t *dat, uint16_t len)
 207          {
 208   1          uint32_t crc = 0xFFFFFFFF;
 209   1          uint16_t i, j;
 210   1      
 211   1          for (i = 0; i < len; i++)
 212   1          {
 213   2              crc ^= (uint32_t)dat[i];
 214   2              for (j = 0; j < 8; j++)
 215   2              {
 216   3                  if (crc & 0x01)
 217   3                  {
 218   4                      crc = (crc >> 1) ^ 0xEDB88320;
 219   4                  }
 220   3                  else
 221   3                  {
 222   4                      crc >>= 1;
 223   4                  }
 224   3              }
 225   2          }
 226   1      
 227   1          return crc ^ 0xFFFFFFFF;
 228   1      }
