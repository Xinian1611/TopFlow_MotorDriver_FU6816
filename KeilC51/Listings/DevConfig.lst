 119          /// @brief 写入设备配置参数
 120          /// @param cfg 配置参数结构体指针
 121          /// @retval None
 122          void DevConfig_WriteParam(const void *cfg)
 123          {
 124   1          if (cfg == NULL)
 125   1              return;
 126   1      
 127   1          if (memcmp(&s_dev_cfg.motor_cfg, cfg, sizeof(MotorDrvCfg_t)) == 0)
 128   1              return;
 129   1      
 130   1          s_dev_cfg.crc = DevConfig_CalcCRC((const uint8_t *)cfg, sizeof(MotorDrvCfg_t));
 131   1      
 132   1          memcpy(&s_dev_cfg.motor_cfg, cfg, sizeof(MotorDrvCfg_t));
 133   1      
 134   1          AT24Cxx_WriteBytes(AT24CXX_CFG_ADDR, (const uint8 *)&s_dev_cfg, sizeof(DevConfig_t));
 135   1      }
