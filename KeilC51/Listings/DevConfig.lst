 123          /// @brief 写入设备配置参数
 124          /// @param cfg 配置参数结构体指针
 125          /// @retval None
 126          void DevConfig_WriteParam(const void *cfg)
 127          {
 128   1          if (cfg == NULL)
 129   1              return;
 130   1      
 131   1          if (memcmp(&s_dev_cfg.motor_cfg, cfg, sizeof(MotorDrvCfg_t)) == 0)
 132   1              return;      /* 和当前配置一样 → 直接返回，不写盘 */
 133   1      
 134   1          s_dev_cfg.crc = DevConfig_CalcCRC((const uint8_t *)cfg, sizeof(MotorDrvCfg_t));
 135   1          memcpy(&s_dev_cfg.motor_cfg, cfg, sizeof(MotorDrvCfg_t));
 136   1      
 137   1          /* 96 字节跨页（0x0000~0x005F）：用自动分页的接口层，内部拆成 64 + 32 两次页�
             -� */
 138   1          (void)EEPROM_WriteBuffer(AT24CXX_CFG_ADDR, sizeof(DevConfig_t), (const uint8_t *)&s_dev_cfg);
 139   1      }
 140          
 141          /// @brief 强制把当前 s_dev_cfg 落盘（不做"是否变化"比较）
 142          /// @note  内部写 96 字节 EEPROM，约 50ms 阻塞；只能在主循环里调用
 143          void DevConfig_ForceSave(void)
 144          {
 145   1          s_dev_cfg.crc = DevConfig_CalcCRC((const uint8_t *)&s_dev_cfg.motor_cfg,
 146   1                                            sizeof(MotorDrvCfg_t));
 147   1          (void)EEPROM_WriteBuffer(AT24CXX_CFG_ADDR, sizeof(DevConfig_t), (const uint8_t *)&s_dev_cfg);
 148   1      }
