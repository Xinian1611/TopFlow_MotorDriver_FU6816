 104   1          AT24Cxx_ReadBytes(AT24CXX_CFG_ADDR, (uint8 *)&s_dev_cfg, sizeof(DevConfig_t));
 105   1      
 106   1          if (s_dev_cfg.magic != DEV_CONFIG_MAGIC_NUMBER ||
 107   1              s_dev_cfg.crc != DevConfig_CalcCRC((const uint8_t *)&s_dev_cfg.motor_cfg, sizeof(MotorDrvCfg_t)))
 108   1          {
 109   2              memset(&s_dev_cfg, 0, sizeof(DevConfig_t));
 110   2              s_dev_cfg.magic = DEV_CONFIG_MAGIC_NUMBER;
 111   2              MOTOR_DRV_CFG_DEFAULT();
 112   2              s_dev_cfg.crc = 0;
 113   2          }
