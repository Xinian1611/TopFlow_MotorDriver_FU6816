  98          /// @brief 载入本地参数
  99          /// @param cfg 配置参数结构体指针
 100          /// @retval None
 101          void DevConfig_LoadParam(void)
 102          {
 103   1          (void)EEPROM_Init();
 104   1      
 105   1          /* 96 字节：读可以跨页，一次读完 */
 106   1          if (EEPROM_OK != EEPROM_ReadBuffer(AT24CXX_CFG_ADDR, sizeof(DevConfig_t), (uint8_t *)&s_dev_cfg))
 107   1          {
 108   2              memset(&s_dev_cfg, 0, sizeof(DevConfig_t));     /* 读失败 → 走下面默认值分支 */
 109   2          }
 110   1      
 111   1          if (s_dev_cfg.magic != DEV_CONFIG_MAGIC_NUMBER ||
 112   1              s_dev_cfg.crc != DevConfig_CalcCRC((const uint8_t *)&s_dev_cfg.motor_cfg, sizeof(MotorDrvCfg_t)))
 113   1          {
 114   2              memset(&s_dev_cfg, 0, sizeof(DevConfig_t));
 115   2              s_dev_cfg.magic = DEV_CONFIG_MAGIC_NUMBER;
