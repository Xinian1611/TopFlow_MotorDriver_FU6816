 216          /// @brief 计算配置参数CRC32校验码
 217          /// @param cfg 配置参数结构体指针
 218          /// @retval CRC32校验码
 219          static uint32_t DevConfig_CalcCRC(const uint8_t *dat, uint16_t len)
 220          {
 221   1          uint32_t crc = 0xFFFFFFFF;
 222   1          uint16_t i, j;
 223   1      
 224   1          for (i = 0; i < len; i++)
 225   1          {
 226   2              crc ^= (uint32_t)dat[i];
 227   2              for (j = 0; j < 8; j++)
 228   2              {
 229   3                  if (crc & 0x01)
 230   3                  {
 231   4                      crc = (crc >> 1) ^ 0xEDB88320;
 232   4                  }
 233   3                  else
 234   3                  {
 235   4                      crc >>= 1;
 236   4                  }
 237   3              }
 238   2          }
