 320          /*------------------------------------------------------------------------------------
 321          函数功能：从参数页读本机地址（对应 f105 Robert_EEPROM.c 的 ReadCANID）
 322          输入参数：无
 323          返回参数：Station_ID（0~127）；参数页全 0xFF 或校验错时返回 0
 324          特别说明：读的是 Flash 0x0F08 起的 7 字节：55 AA + 4B(Station<<4，大端) + XOR
 325                    必须用 code 指针读，否则读到的是 xdata
 326          ------------------------------------------------------------------------------------*/
 327          uint16_t ReadCANID(void)
 328          {
 329   1        uint8_t readout[StationIDSize] = {0};
 330   1        uint8_t CRC_Result = 0;
 331   1        uint32_t result = 0;
 332   1        uint8_t i;
 333   1      
 334   1        for(i = 0;i < StationIDSize;i++)
 335   1          readout[i] = *(uint8_t code *)(STM_FLASH_BASE + IAPID_FLASH_OFFSET + i);
 336   1      
 337   1        CRC_Result = CheckXor(&readout[0],StationIDSize-1);
 338   1        if((CRC_Result == readout[StationIDSize-1]) && (readout[0] == 0x55) && (readout[1] == 0xAA))
 339   1        {
 340   2          result = ((uint32_t)readout[2] << 24) | ((uint32_t)readout[3] << 16) |
 341   2                   ((uint32_t)readout[4] << 8)  | (uint32_t)readout[5];
 342   2          return (uint16_t)(result >> 4);
 343   2        }
 344   1        return 0;
 345   1      }
