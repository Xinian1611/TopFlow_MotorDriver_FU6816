 324          /*------------------------------------------------------------------------------------
 325          函数功能：异或校验（f105 Robert_EEPROM.c 原函数）
 326          输入参数：strData：数据首地址；len：参与校验的字节数
 327          返回参数：各字节异或结果
 328          特别说明：只用于参数页里的 5 字节标志 / 7 字节 ID，不做 CRC16
 329          ------------------------------------------------------------------------------------*/
 330          uint8_t CheckXor(uint8_t *strData,int len)
 331          {
 332   1        uint8_t checksum = 0;
 333   1        int i;
 334   1        for(i = 0;i < len;i++)
 335   1          checksum = checksum ^ strData[i];
 336   1        return checksum;
 337   1      }
