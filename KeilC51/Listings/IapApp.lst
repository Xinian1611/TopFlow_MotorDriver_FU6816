 339          /*------------------------------------------------------------------------------------
 340          函数功能：从参数页读本机地址（对应 f105 Robert_EEPROM.c 的 ReadCANID）
 341          输入参数：无
 342          返回参数：Station_ID（0~127）；参数页全 0xFF 或校验错时返回 0
 343          特别说明：读的是 Flash 0x0F08 起的 7 字节：55 AA + 4B(Station<<4，大端) + XOR
 344                    必须用 code 指针读，否则读到的是 xdata
 345          ------------------------------------------------------------------------------------*/
 346          uint16_t ReadCANID(void)
 347          {
 348   1        uint8_t readout[StationIDSize] = {0};
 349   1        uint8_t CRC_Result = 0;
 350   1        uint32_t result = 0;
 351   1        uint8_t i;
 352   1      
 353   1        for(i = 0;i < StationIDSize;i++)
 354   1          readout[i] = *(uint8_t code *)(STM_FLASH_BASE + IAPID_FLASH_OFFSET + i);
 355   1      
 356   1        CRC_Result = CheckXor(&readout[0],StationIDSize-1);
 357   1        if((CRC_Result == readout[StationIDSize-1]) && (readout[0] == 0x55) && (readout[1] == 0xAA))
 358   1        {
 359   2          result = ((uint32_t)readout[2] << 24) | ((uint32_t)readout[3] << 16) |
 360   2                   ((uint32_t)readout[4] << 8)  | (uint32_t)readout[5];
 361   2          return (uint16_t)(result >> 4);
