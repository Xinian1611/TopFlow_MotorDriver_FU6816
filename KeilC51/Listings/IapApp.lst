 305          /*------------------------------------------------------------------------------------
 306          函数功能：异或校验（f105 Robert_EEPROM.c 原函数）
 307          输入参数：strData：数据首地址；len：参与校验的字节数
 308          返回参数：各字节异或结果
 309          特别说明：只用于参数页里的 5 字节标志 / 7 字节 ID，不做 CRC16
 310          ------------------------------------------------------------------------------------*/
 311          uint8_t CheckXor(uint8_t *strData,int len)
 312          {
 313   1        uint8_t checksum = 0;
 314   1        int i;
 315   1        for(i = 0;i < len;i++)
 316   1          checksum = checksum ^ strData[i];
 317   1        return checksum;
 318   1      }
