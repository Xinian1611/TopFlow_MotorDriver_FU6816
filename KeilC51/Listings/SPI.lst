  17          /** 
  18           * @brief        SPI初始化
  19           * @date         2022-09-13
  20           */
  21          void SPI_Init(void)
  22          {
  23   1          ClrBit(SPI_CR1, SPIEN);                                            // 0,disable SPI;1 enable
  24   1          /*  -------------------------------------------------------------------------------------------------
  25   1              SPI管脚配置
  26   1              1、禁止UART复用，P06配置为MISO，P05配置为MOSI
  27   1              2、禁止比较器输出复用，P07配置为SCLK
  28   1              -------------------------------------------------------------------------------------------------*
             -/
  29   1          ClrBit(PH_SEL, UART1EN);                                              // 0,P06 as GPIO or SPI_MISO,P05
             - as GPIO or SPI_MOSI;1,P06 and p07 as USART
  30   1          /*  -------------------------------------------------------------------------------------------------
  31   1              SPI时钟相位/极性配置
  32   1              CPHA = 0, CPOL = 0:上升沿接收，下降沿发送，空闲电平为低
  33   1              CPHA = 0, CPOL = 1:上升沿发送，下降沿接收，空闲电平为高
  34   1              CPHA = 1, CPOL = 0:上升沿发送，下降沿接收，空闲电平为低
  35   1              CPHA = 1, CPOL = 1:上升沿接收，下降沿发送，空闲电平为高
  36   1              -------------------------------------------------------------------------------------------------*
             -/
  37   1          SetReg(SPI_CR0, CPHA | CPOL, CPOL);
  38   1       
  39   1      // 三线模式，MCU的 SCLK NSS MOSI 接SPI小板的 SCLK NSS MOSI，    SPI拨码开关：SW2 = 0;SW3 =
             - 0;    
  40   1      // 双线模式，MCU的 SCLK MOSI     接SPI小板的 SCLK  MOSI，       SPI拨码开关：SW2 = 1;SW2 =
             - 0;   
  41   1      // 单线模式，MCU的 SCLK          接SPI小板的 MOSI，             SPI拨码开关：SW2 = 1;SW3 =
             - 1;   
  42   1          
  43   1          #if (SPI_DBG_MODE == DBG_SPI_1)
  44   1          {
  45   2              ClrBit(SPI_CR1,NSSMOD1);
  46   2              SetBit(SPI_CR1,NSSMOD0);
  47   2          
C51 COMPILER V9.60.7.0   SPI                                                               09/21/2026 11:30:57 PAGE 2   

  48   2          //SetBit(PH_SEL1 , SPICT0);                         //单线制SPI功能转移(P05-->P00)
  49   2          }
  50   1          #elif (SPI_DBG_MODE == DBG_SPI_2)
                  {
                      ClrBit(SPI_CR1,NSSMOD1);
                      ClrBit(SPI_CR1,NSSMOD0);        
                  }
                  #else
                  {
                      SetBit(SPI_CR1,NSSMOD1);
                      SetBit(SPI_CR1,NSSMOD0);
                  }
                  #endif
  61   1              
  62   1          
  63   1        
  64   1          SetBit(SPI_CR0, SPIMS);                          // 0:Slave, 1:Master
  65   1          /*  -------------------------------------------------------------------------------------------------
  66   1              SPI中断配置
  67   1              SPIF：SPI字节传输完成中断标志，硬件置位，软件清零
  68   1              WCOL：SPI写冲突中断（发送缓冲器非空时写操作），硬件置位，软件清零
  69   1              MODF：SPI方式错误中断（多主方式NSS被拉低，MSTEN和SPIEN被清零）硬件置位，
             -软件清零
  70   1              RXOVRN：SPI接收溢出中断（SPI接收缓冲器接收溢出），硬件置位，软件清零
  71   1              -------------------------------------------------------------------------------------------------*
             -/
  72   1          SetReg(SPI_CR1, SPIIF | WCOL | MODF | RXOVRN, 0x00);           // SPI所有中断清除
  73   1          SPIIE = 0;                                                     // SPI中断使能
  74   1          SPI_CLK = 1;                                                   // Fspi = Fcpu / (2*(SPI_CLK + 1)) = 6M
             -Hz
  75   1          SetBit(SPI_CR1, SPIEN);                                        // enable SPI
  76   1      }
