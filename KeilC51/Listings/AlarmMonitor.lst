 108          /// @brief 读取 OVP 输入电源电压
 109          /// @retval 0.01V；换算：Vraw = raw × VREF × 1150/150 / 32768
 110          static uint16_t alarm_read_ovp_cv(void)
 111          {
 112   1          int16_t raw;
 113   1      
 114   1          raw = (int16_t)(OVP_ADC_DR & 0x7FFF);
 115   1      
C51 COMPILER V9.60.7.0   ALARMMONITOR                                                      10/27/2026 17:50:53 PAGE 3   

 116   1          if (s_ovp_inited == 0)
 117   1          {
 118   2              s_ovp_filtered = raw;          /* 首次直接装载，防止上电从0爬升误报低压 */
 119   2              s_ovp_inited   = 1;
 120   2          }
 121   1          else
 122   1          {
 123   2              s_ovp_filtered = MDU_LPF0(raw, s_ovp_filtered, OVP_LPF_K);
 124   2          }
 125   1      
 126   1          /* raw(0~32767) × 满量程(0.01V) / 32768
 127   1           * 1150/150、VREF=4.5V 时满量程 = 3450（34.50V） */
 128   1          s_ovp_volt_cv = (uint16_t)(((uint32_t)(uint16_t)s_ovp_filtered
 129   1                                      * (uint32_t)OVP_FULL_SCALE_CV) >> 15);
 130   1          return s_ovp_volt_cv;
 131   1      }
