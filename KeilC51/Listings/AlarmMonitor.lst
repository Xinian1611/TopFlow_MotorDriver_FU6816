 386          /// @brief 根据告警队列更新故障码
 387          static void alarm_update_fault(void)
 388          {
 389   1          // 构建活跃故障码队列
 390   1          alarm_build_queue();
 391   1      
 392   1          // 无活跃故障
 393   1          if (g_alarm_monitor.fault_count == 0)
 394   1          {
 395   2              // 清除故障码(通信超时故障不由告警模块管理, 不清除)
 396   2              if (g_run_state.fault_code != FAULT_NONE &&
 397   2                  !(FAULT_GET_LEVEL(g_run_state.fault_code) == FAULT_LEVEL_3 &&
 398   2                    FAULT_GET_CODE(g_run_state.fault_code) == FAULT3_COMM_STOP))
 399   2              {
 400   3                  ext_clear_fault();
 401   3              }
 402   2              g_alarm_monitor.rotate_index = 0;
 403   2              return;
 404   2          }
 405   1      
 406   1          // 修正轮转索引越界
 407   1          if (g_alarm_monitor.rotate_index >= g_alarm_monitor.fault_count)
 408   1          {
 409   2              g_alarm_monitor.rotate_index = 0;
 410   2          }
 411   1      
 412   1          // 设置当前轮转位置的故障码到运行状态
 413   1          g_run_state.fault_code = g_alarm_monitor.fault_queue[g_alarm_monitor.rotate_index];
 414   1      }
