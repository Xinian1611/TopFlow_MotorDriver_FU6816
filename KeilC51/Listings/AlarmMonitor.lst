 107          /// @brief 读取 OVP 输入电源电压
 108          /// @retval 0.01V；换算：Vraw = raw × VREF × 1150/150 / 32768
 109          static uint16_t alarm_read_ovp_cv(void)
 110          {
 111   1          int16_t raw;
 112   1      
 113   1          raw = (int16_t)(OVP_ADC_DR & 0x7FFF);
 114   1      
 115   1          if (s_ovp_inited == 0)
C51 COMPILER V9.60.7.0   ALARMMONITOR                                                      10/20/2026 17:28:30 PAGE 3   

 116   1          {
 117   2              s_ovp_filtered = raw;          /* 首次直接装载，防止上电从0爬升误报低压 */
 118   2              s_ovp_inited   = 1;
 119   2          }
 120   1          else
 121   1          {
 122   2              s_ovp_filtered = MDU_LPF0(raw, s_ovp_filtered, OVP_LPF_K);
 123   2          }
 124   1      
 125   1          /* raw(0~32767) × 满量程(0.01V) / 32768
 126   1           * 1150/150、VREF=4.5V 时满量程 = 3450（34.50V） */
 127   1          s_ovp_volt_cv = (uint16_t)(((uint32_t)(uint16_t)s_ovp_filtered
 128   1                                      * (uint32_t)OVP_FULL_SCALE_CV) >> 15);
 129   1          return s_ovp_volt_cv;
 130   1      }
