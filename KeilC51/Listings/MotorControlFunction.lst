 746          /**
 747           * @brief     三下桥刹车
 748           * @date      2022-07-14
 749           */
 750          void MC_Break(void)
 751          {
 752   1          MOE         = 1;
 753   1          ClrBit(DRV_CR, FOCEN);  // 关闭FOC
 754   1          /*  软件设置PWM占空比输出以上桥为参考，配置为互补输出时下桥反向 */
 755   1          ClrBit(DRV_CR, OCS);    // OCS = 0, DRV_COMR;  OCS = 1, FOC/SVPWM/SPWM
 756   1          SetBit(DRV_CR, DRVEN);  // 计数器使能      0-->Disable 1-->Enable
 757   1          DRV_CMR = 0x0015;       //  关闭上桥输出，开启下桥输出
 758   1          DRV_DR  = (DRV_ARR) + 4 ; // ARR+4为全开
 759   1      }
