 894   1          {
 895   2              SquStart.Temp = FOC__THETA;
 896   2              SquStart.Temp = SquStart.Temp + 150;
 897   2              SquStart.Temp1 = SquStart.Temp - (_Q15(91.0 / 180.0) + CW_THETA_BASE);
 898   2              
 899   2              if ((SquStart.Temp1 > 0) && (SquStart.Temp1 < (150 + 5)))
 900   2              {
 901   3                  #if (Shunt_Resistor_Mode == Single_Resistor)
 902   3                  {
 903   4                      #if (Start_Single_Resistor_Mode == SVPWM_OPTIM)
 904   4                      {
 905   5                          SetReg(FOC_CR1, CSM0 | CSM1, CSM1);                 // 新单电阻采样配置
 906   5                          FOC_TRGDLY = SVPWM_OPTIM_TRGDLY;                    // 采样时刻在中点，一般考虑开�
             -�噪声影响，会设置延迟；
 907   5                      }
 908   4                      #else
                              {
                                  FOC_TRGDLY = SVPWM_COMMOM_TRGDLY;                   // 采样时刻在中点，一般考虑开�
             -�噪声影响，会设置延迟；
                                  SetReg(FOC_CR1, CSM0 | CSM1, 0);                    // 单电阻采样配置
                              }
                              #endif
 914   4                      FOC_TSMIN  = PWM_TS_LOAD;                           // 最小采样窗口
 915   4                      // 如：0x0c表示延迟12个clock，提前用反码形式，如0x84表示提前12个clock。
 916   4                      ClrBit(FOC_CR2, F5SEG);                             // 7段式，单电阻仅支持7段式
 917   4                  }
 918   3                  #endif
 919   3                  SquStart.StartState = 0;
 920   3                  FOC__THETA = _Q15(91.0 / 180.0) + CW_THETA_BASE;
 921   3                  FOC__ETHETA = FOC__THETA  - 4096;
 922   3                  FOC_IDREF           = ID_Start_CURRENT;                         // D?????
 923   3                  mcFocCtrl.IqRef         = IQ_Start_CURRENT;
 924   3                  FOC_DKP             = DKP;
 925   3                  FOC_DKI             = DKI;
 926   3                  FOC_QKP             = QKP;
 927   3                  FOC_QKI             = QKI;
 928   3                  FOC_EKP    = OBSW_KP_GAIN_Switch;
 929   3                  FOC_EKI    = OBSW_KI_GAIN_Switch;
 930   3                  FOC_EFREQACC  = 300;
 931   3                  FOC_EFREQMIN  = 0.8 * FOCSwitchSpeed / Pole_Pairs;
 932   3                  FOC_EFREQHOLD = FOCSwitchSpeed / Pole_Pairs;
 933   3                  SetReg(FOC_CR1, EFAE | RFAE | ANGM, EFAE | ANGM);
 934   3                  mcFocCtrl.State_Count = 25 + (ATO_RAMP_PERIOD << 2);
 935   3                  FOC_OMEKLPF        = SPEED_KLPF;
 936   3                  FOC__EOME = SquStart.MotorSpeed / (uint8)(Pole_Pairs);
 937   3                  FOC__UQ = SquStart.StartUq;
 938   3                  FOC_IQREF = mcFocCtrl.IqRef;                          // Q?????
 939   3                  ClrBit(FOC_CR2, UQD);
 940   3                  ClrBit(FOC_CR2, UDD);
 941   3                  mcState = mcRun;
 942   3              }
 943   2              else
 944   2              {
 945   3                  FOC__THETA = SquStart.Temp;
 946   3              }
 947   2          }
 948   1      }
