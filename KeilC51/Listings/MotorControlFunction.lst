 683          /* ==========================================================================
 684           *  ★ 改写后的 MC_Stop()：三段式停机
 685           *    ① 给定降 0，让速度环把电机拉停（电流受 SOUTMAX / 硬件过流保护）
 686           *    ② 停稳确认：|SpeedFlt| 连续 STOP_CONFIRM_MS 都在阈值以下
 687           *    ③ 请求合闸 → 进 mcBrake 等确认 → 确认后才关 MOE（见 MotorControl.c）
 688           *
 689           *  ★ 不再默认走 MC_Break()：短路刹车电流在桥臂内环流、不经过母线单电阻，
 690           *    硬件过流保护看不到，详见手册 §12.2。
 691           * ========================================================================== */
 692          #define STOP_CONFIRM_SPEED_RPM   S_Value(50)      /* (RPM) 停稳判据：低于此转速算停住 */
 693          #define STOP_CONFIRM_MS          (200)            /* (ms) 连续低于阈值多久算停稳 */
 694          #define STOP_DECEL_TIMEOUT_MS    (5000)           /* (ms) 减速超时兜底 → 直接合闸断输出 */
 695          
 696          /**
 697           * @brief  速度绝对值（S 值）
 698           */
 699          static int16 SpeedFltAbs(void)
 700          {
 701   1          int16 s;
 702   1      
 703   1          s = mcFocCtrl.SpeedFlt;
 704   1          return (int16)((s < 0) ? -s : s);
 705   1      }
 706          
 707          void MC_Stop(void)
 708          {
 709   1          static uint16 stopStableCnt = 0;      /* 停稳连续计数（ms）*/
C51 COMPILER V9.60.7.0   MOTORCONTROLFUNCTION                                              10/27/2026 17:50:53 PAGE 13  

 710   1          static uint16 stopTotalCnt  = 0;      /* 减速总计时（ms）*/
 711   1      
 712   1          /* ---- ① 降速：让速度环把电机拉停 ---- */
 713   1          mcFocCtrl.Ref = 0;
 714   1      
 715   1          if (stopTotalCnt < 0xFFFF) { stopTotalCnt++; }
 716   1      
 717   1          /* ---- ② 停稳确认 ---- */
 718   1          if (SpeedFltAbs() > STOP_CONFIRM_SPEED_RPM)
 719   1          {
 720   2              stopStableCnt = 0;                /* 还在转，重新计时 */
 721   2          }
 722   1          else if (stopStableCnt < STOP_CONFIRM_MS)
 723   1          {
 724   2              stopStableCnt++;
 725   2          }
 726   1      
 727   1          /* ---- ③ 停稳（或减速超时）→ 请求合闸，转 mcBrake 等确认 ---- */
 728   1          if ((stopStableCnt >= STOP_CONFIRM_MS) || (stopTotalCnt >= STOP_DECEL_TIMEOUT_MS))
 729   1          {
 730   2              Brake_RequestLock();
 731   2              stopStableCnt = 0;
 732   2              stopTotalCnt  = 0;
 733   2              mcState       = mcBrake;
 734   2          }
 735   1      
 736   1          #if (StopBrakeFlag != 0)
                  /* ---- 可选的兜底短路刹车：只在【已停稳】时才允许，此时转速很低、电流�
             -��全 ---- */
                  if ((mcState == mcBrake) && (SpeedFltAbs() < Stop_MOTOR_SPEED_RPM))
                  {
                      MC_Break();
                      mcFocCtrl.State_Count = StopWaitTime;
                  }
                  #endif
 744   1      }
