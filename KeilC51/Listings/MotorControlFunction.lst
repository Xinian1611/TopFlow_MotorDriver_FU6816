 234          /**
 235           * @brief     预充电分三步，第一步是对U相进行预充电，第二步是对V两相进行预充
             -电;第三步是对W三相进行预充电。
 236           * @brief     低压应用一般不需要预充电，在customer.h禁止预充电功能寄即可
 237           * @exception 在低功率高压应用中，过流值较小，充电电流过大可能导致触发硬件�
             -�流, 需要注意检查
 238           * @date      2022-07-14
 239           */
 240          void Motor_Charge(void)
 241          {
 242   1          if (McStaSet.SetFlag.ChargeSetFlag == 0)
 243   1          {
 244   2              McStaSet.SetFlag.ChargeSetFlag = 1;
 245   2              SetBit(DRV_CR, DRVEN);  // 计数器使能      0-->Disable 1-->Enable
 246   2              DRV_DR = CHARGE_DUTY * DRV_ARR;              //下桥臂10% duty
 247   2              DRV_CMR &= 0x0000;
 248   2              /*  ----------------------------------------------------------------------------------------------
             ----
 249   2                  DRV_CTL：PWM来源选择
 250   2                  OCS = 0, DRV_COMR
 251   2                  OCS = 1, FOC/SVPWM/SPWM
 252   2                  ----------------------------------------------------------------------------------------------
             ----*/
 253   2              ClrBit(DRV_CR, OCS);
 254   2              mcFocCtrl.ChargeStep = 0;
 255   2          }
 256   1          
 257   1          if ((mcFocCtrl.State_Count < CHARGE_TIME) && (mcFocCtrl.ChargeStep == 0))
 258   1          {
 259   2              mcFocCtrl.ChargeStep = 1;
 260   2              DRV_CMR |= 0x01;                          // U相下桥臂通
 261   2              MOE = 1;
 262   2          }
 263   1          
 264   1          if (( mcFocCtrl.State_Count <= (CHARGE_TIME << 1) / 3) && (mcFocCtrl.ChargeStep == 1))
 265   1          {
 266   2              mcFocCtrl.ChargeStep = 2;
 267   2              DRV_CMR |= 0x04;                         // V相下桥臂通
 268   2          }
 269   1          
 270   1          if ((mcFocCtrl.State_Count <= CHARGE_TIME / 3) && (mcFocCtrl.ChargeStep == 2))
 271   1          {
 272   2              mcFocCtrl.ChargeStep = 3;
 273   2              DRV_CMR |= 0x10;                          // W相下桥臂通
 274   2          }
 275   1          
 276   1          #if (IPMTEST ==Enable)
                  {
                      if (mcFocCtrl.ChargeStep == 3)
                      {
                          mcFocCtrl.ChargeStep = 4;
                          DRV_CMR = 0x0ABF;
                      }
                  }
                  #endif
 285   1      }
