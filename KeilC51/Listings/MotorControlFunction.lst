 680          /**
 681           * @brief     三下桥刹车
 682           * @date      2022-07-14
 683           */
 684          void MC_Break(void)
 685          {
 686   1          MOE         = 1;
 687   1          ClrBit(DRV_CR, FOCEN);  // 关闭FOC
 688   1          /*  软件设置PWM占空比输出以上桥为参考，配置为互补输出时下桥反向 */
 689   1          ClrBit(DRV_CR, OCS);    // OCS = 0, DRV_COMR;  OCS = 1, FOC/SVPWM/SPWM
 690   1          SetBit(DRV_CR, DRVEN);  // 计数器使能      0-->Disable 1-->Enable
 691   1          DRV_CMR = 0x0015;       //  关闭上桥输出，开启下桥输出
 692   1          DRV_DR  = (DRV_ARR) + 4 ; // ARR+4为全开
 693   1      }
