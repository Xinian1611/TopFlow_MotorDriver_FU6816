 486          /* -------------------------------------------------------------------------------------------------
 487              Function Name  : Fault_Detection
 488              Description    : 故障检测与保护,扫描周期默认为1ms
 489                               所有故障发送只进行 故障码 赋值
 490                               禁止在状态机以外地方进行状态跳转
 491              Date           : 2022-07-01
 492              Parameter      : None
 493          ------------------------------------------------------------------------------------------------- */
 494          void Fault_Detection(void)
 495          {
 496   1          #if (OverTPProtectEn == 1)
                  {
                      Fault_TSDTemperature();
                      Fault_NTCTemperature();
                  }
                  #endif
 502   1          #if (VoltageProtectEn == 1)
                  {
                      Fault_Voltage();
                  }
                  #endif
