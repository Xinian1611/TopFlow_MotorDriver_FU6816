  21          /* ==========================================================================
  22           *   硬件过流跳闸后的"重启闸门"
  23           * ========================================================================== */
  24          #define RECOVER_HOLDOFF_MS      (1500)      /* (ms) 跳闸后最短静默时间 */
  25          #define RECOVER_CURRENT_MAX     (200)       /* (ADC counts) 母线电流"已衰减"判据，ΔI ≈ 0.8A *
             -/
  26          #define RECOVER_CURRENT_OK_MS   (500)       /* (ms) 电流需连续低于阈值多久 */
  27          #define RECOVER_RESTART_DELAY_MS (3000)     /* (ms) 条件满足后再等多久才放行启动 */
  28          
  29          void Fault_Recovery_ManualTarget(void)
  30          {
  31   1          static uint16 holdCnt     = 0;
  32   1          static uint16 curOkCnt    = 0;
  33   1          static uint16 readyDelay  = 0;
  34   1          uint8         g_reArmEnable = 1;        /*  接外部复位源：默认常开=自动重臂 */
  35   1      
  36   1          if (mcState != mcFault)
  37   1          {
  38   2              /* 没在故障态：条件满足后复位闸门，允许下一次启动 */
  39   2              if ((holdCnt >= RECOVER_HOLDOFF_MS) &&
  40   2                  (curOkCnt >= RECOVER_CURRENT_OK_MS) &&
  41   2                  (readyDelay >= RECOVER_RESTART_DELAY_MS))
  42   2              {
  43   3                  g_runBlocked = 0;
  44   3              }
  45   2              return;
  46   2          }
  47   1      
  48   1          /* ---- 故障态：先把闸门关上，再按条件逐步放行 ---- */
  49   1          g_runBlocked = 1;
  50   1      
  51   1          if (g_reArmEnable == 0) { return; }     /* 需要人工复位：一直关着 */
  52   1      
C51 COMPILER V9.60.7.0   MOTORPROTECT                                                      10/20/2026 17:28:31 PAGE 2   

  53   1          if (holdCnt < RECOVER_HOLDOFF_MS) { holdCnt++; }
  54   1          else if (Power_Currt <= RECOVER_CURRENT_MAX)
  55   1          {
  56   2              if (curOkCnt < RECOVER_CURRENT_OK_MS) { curOkCnt++; }
  57   2          }
  58   1          else
  59   1          {
  60   2              curOkCnt = 0;                       /* 电流又上来了：重新计时 */
  61   2          }
  62   1      
  63   1          if (g_runBlocked == 1)
  64   1          {
  65   2              if (readyDelay < RECOVER_RESTART_DELAY_MS) { readyDelay++; }
  66   2          }
  67   1      
  68   1          /* 上面三步都到点了，下一拍 mcState 已回 mcReady，闸门在函数开头被打开 */
  69   1      }
