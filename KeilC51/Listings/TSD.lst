  54          /* ==================== NTC 原值的 50 点截尾平均 ====================
  55           * 为什么存 8 位：ADC2_DR 是"左次高位对齐"（ADCALIGN=1 → 结果在 [14:3]），取高 8 �
             -�
  56           *   （>>7）存进 50 字节缓冲；30 点平均后分辨率约 1/256 满量程
  57           *   （4.5V 下 ≈17.6mV ≈ NTC 0.3℃），远优于测试文档 5% 的判据，
  58           *   同时省 XDATA（存 15 位要 100 字节，本工程只剩约 100 字节）。
  59           */
  60          #define NTC_TRIM_POINTS     (50)
  61          #define NTC_TRIM_DROP       (10)
  62          
  63          static uint8  xdata s_ntcBuf[NTC_TRIM_POINTS];
  64          static uint8  xdata s_ntcCnt  = 0;
  65          static uint16 xdata s_ntcTrim = 0;
  66          
  67          void NTC_TrimPush(uint8 v)
  68          {
  69   1          uint8  i, j, t;
  70   1          uint16 sum;
  71   1      
  72   1          s_ntcBuf[s_ntcCnt++] = v;
  73   1          if (s_ntcCnt < NTC_TRIM_POINTS)
  74   1          {
  75   2              return;                                 /* 还没满 50 点 */
  76   2          }
  77   1          s_ntcCnt = 0;
  78   1      
  79   1          /* 升序插入排序（50 点最坏约 1225 次比较；每 50ms 才跑一次，开销可忽略）*/
  80   1          for (i = 1; i < NTC_TRIM_POINTS; i++)
  81   1          {
  82   2              t = s_ntcBuf[i];
  83   2              j = i;
  84   2              while ((j > 0) && (s_ntcBuf[j - 1] > t))
  85   2              {
  86   3                  s_ntcBuf[j] = s_ntcBuf[j - 1];
  87   3                  j--;
  88   3              }
  89   2              s_ntcBuf[j] = t;
  90   2          }
  91   1      
  92   1          /* 去掉最小的 10 个和最大的 10 个，取中间 30 个的平均 */
  93   1          sum = 0;
  94   1          for (i = NTC_TRIM_DROP; i < (NTC_TRIM_POINTS - NTC_TRIM_DROP); i++)
  95   1          {
  96   2              sum += s_ntcBuf[i];
  97   2          }
  98   1          s_ntcTrim = (uint16)(sum / (NTC_TRIM_POINTS - 2 * NTC_TRIM_DROP));   /* /30 */
  99   1      }
 100          
 101          uint16 NTC_TrimValue(void)
 102          {
 103   1          return s_ntcTrim;
 104   1      }
