 106          /* ==========================================================================
 107           *   新增：驱动模块温度换算（NTC 分压节点电压 mV → NTC 阻值 → B 公式温度 ℃�
             -�
 108           *  与旧 GD32 工程 Motor_MD() 逐行对应，函数体一个字符没改；
 109           *  只换掉两个和芯片相关的入口：
 110           *    ① 入参 ch（旧工程有 ZXWD_DET / ZDWD_DET 两路）→ 本板只有一路 NTC，接 P2.4 = AD
             -2
 111           *    ② ADC_Filter_GetChannelValueF(ch)（旧工程 DMA 多点去极值均值）
 112           *       → FU6866 是硬件自动扫通道，用本工程已经在跑的滤波器 mcFocCtrl.NTCTempFlt
C51 COMPILER V9.60.7.0   TSD                                                               10/27/2026 17:50:55 PAGE 3   

 113           *  注：分压网络 5V 供电而 ADC 参考 4.5V（旧工程 3.3V，本板 4.5V，同样有饱和限制
             -）
 114           * ========================================================================== */
 115          
 116          /**
 117           * @brief  驱动模块温度换算：NTC 分压节点电压(mV) → NTC 阻值 → B公式温度(°C)
 118           * @param  adc_filt_counts  NTC 通道的 ADC 滤波值（ADC counts）
 119           * @return 温度（℃）；读数不可信返回 MOTOR_MD_ERR
 120           * @note   旧工程这里收的是"已经换算好的 mV"，本板收的是 ADC counts，
 121           *         所以前面多一句码值→mV；系数直接用本工程的 Brake.c:60 同一套（VREF=4500
             -mV / 32768）
 122           */
 123          float Motor_MD(uint16 adc_filt_counts)
 124          {
 125   1          float v_node_mv;
 126   1          float v_node;
 127   1          float r_ntc;
 128   1          float temperature;
 129   1      
 130   1          adc_filt_counts &= 0x7FFF;                      /* 15bit 有效，最高位是状态位 */
 131   1      
 132   1          /* ---- 码值 → 节点电压 mV（等价于旧工程的 ADC_Filter_GetChannelValueF(ch)）---- */
 133   1          v_node_mv = ((float)((uint32)adc_filt_counts * 4500UL)) / 32768.0f;
 134   1      
 135   1          /* ---- 饱和/开路判据，对应旧工程注释里那句"低温时节点电压饱和，读数失�
             -�" ----
 136   1           *  本板 VREF=4.5V，所以饱和点比旧板（3.3V）更靠上：
 137   1           *    低于 0.05V → 上拉断路/通道没扫到
 138   1           *    高于 4.30V → 节点已经顶到参考，r_ntc 反解出来是假的
 139   1           *  旧工程没写返回什么，这里统一返回 MOTOR_MD_ERR，由调用者忽略 */
 140   1          if (v_node_mv < 50.0f)   { return MOTOR_MD_ERR; }
 141   1          if (v_node_mv > 4300.0f) { return MOTOR_MD_ERR; }
 142   1      
 143   1          /* ↓↓↓ 以下 3 行与旧工程完全一致，只是 v_node 由上面算出来 ↓↓↓ */
 144   1          v_node = v_node_mv / 1000.0f;                                   /* mV→V */
 145   1          r_ntc  = 10000.0f * v_node / (5.0f - v_node);                   /* 分压反解 NTC 阻值，Ω */
 146   1          // temperature = 1.0f / (1.0f / 298.15f + logf(r_ntc / 10000.0f) / 3450.0f) - 273.15f;
 147   1          temperature = 1.0f / (1.0f / 298.15f + (float)(log((double)(r_ntc / 10000.0f)) / 3450.0)) - 273.15f;
 148   1      
 149   1          return temperature;
 150   1      }
 151          
 152          /**
 153           * @brief  20ms 节拍调用：读 NTC → Motor_MD() → 存进 mcFocCtrl.NTCTempNum（0.1℃）
 154           * @note   float / log() 不进 1ms 任务，只在 main 大循环里跑
 155           */
 156          void Motor_MD_Sample(void)
 157          {
 158   1          float temp;
 159   1      
 160   1          /* NTC 电压的低通已经在 AddFunction.c:852（TickCycle_1ms）里做过了，这里直接用 */
 161   1          temp = Motor_MD((uint16)mcFocCtrl.NTCTempFlt);
 162   1      
 163   1          if (temp != MOTOR_MD_ERR)
 164   1          {
 165   2              /* ℃ → 0.1℃，四舍五入 */
 166   2              mcFocCtrl.NTCTempNum = (int16)(temp * 10.0f + ((temp >= 0.0f) ? 0.5f : -0.5f));
 167   2          }
 168   1          /* 读数不可信时保持上一次的值不动，不刷新 NTCTempNum */
 169   1      }


