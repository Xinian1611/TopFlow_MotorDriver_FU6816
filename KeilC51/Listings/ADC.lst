  18          void ADC_Init(void)
  19          {
  20   1          /********************ADC 端口模拟功能设置************************/
  21   1          SetBit(P2_AN, PIN0);    //AD0 P20 CH open--IU--固定
  22   1          SetBit(P2_AN, PIN3);    //AD1 P23 CH open--IV--固定
  23   1          SetBit(P2_AN, PIN4);    //AD2 P24 CH open--IV--固定
  24   1          SetBit(P2_AN, PIN5);    //AD3 P25 CH open
  25   1          SetBit(P2_AN, PIN7);    //AD4 P27 CH open--IBUS/IW--固定
  26   1          //  SetBit(P3_AN , PIN2);   //AD5 P32 CH open
  27   1          //  SetBit(P3_AN , PIN3);   //AD6 P33 CH open
  28   1          SetBit(P3_AN, PIN4);    //AD7 P34 CH open
  29   1          //  SetBit(P2_AN , PIN1);   //AD8 P21 CH open
  30   1          //  SetBit(P1_AN , PIN6);   //AD9 P16 CH open
  31   1          //  SetBit(P1_AN , PIN4);   //AD10 P14 CH open
  32   1          SetBit(P2_AN , PIN6);   //AD11 P26 CH open
  33   1          //  SetBit(P1_AN , PIN3);   //AD12 P13 CH open
  34   1          //  SetBit(P1_AN , PIN5);   //AD13 P15 CH open
  35   1          /****************************************************************/
  36   1          SetBit(ADC_MASK, CH0EN | CH1EN | CH2EN | CH3EN | CH4EN | CH7EN  | CH11EN| CH15EN);   //通道使能
  37   1          #if(VOLTAGE_MODE == INTERNAL)
                  {
                      #if(VOLTAGE_SCALE == Ratio_6_5)
                      SetBit(ADC_CR, ADCRATIO);           //
                      #else
                      ClrBit(ADC_CR, ADCRATIO);
                      #endif
                  }
                  #endif
  46   1          SetBit(ADC_CR, ADCALIGN);       //ADC数据次高位对齐使能0-->Disable 1-->Enable
  47   1          ClrBit(ADC_CR, ADCIE);          //ADC中断使能
  48   1          SetBit(ADC_CR, ADCEN);          //Enable ADC0
  49   1      }
