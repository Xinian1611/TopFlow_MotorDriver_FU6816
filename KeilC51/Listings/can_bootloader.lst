  54          /**
  55            * @brief  将数据烧写到指定地址的Flash中 。
  56            * @param  Address Flash起始地址。
  57            * @param  Data 数据存储区起始地址。
  58            * @param  DataNum 数据字节数。
  59            * @retval 数据烧写状态。
  60            */
  61          FLASH_Status CAN_BOOT_ProgramDatatoFlash(uint16_t StartAddress,uint8_t *pData,uint16_t DataNum)
  62          {
  63   1        FLASH_Status FLASHStatus = FLASH_COMPLETE;
  64   1        uint16_t i=0,len=0;
  65   1      
  66   1        /* 地址校验以APP地址参考 */
  67   1        if(StartAddress < APP_EXE_FLAG_START_ADDR)
  68   1          return FLASH_ERROR_PG;
  69   1      
  70   1        /* 块固定 1024 字节（4 的倍数），按 4 字节写即可，与公司方案一致 */
  71   1        len = (uint16_t)(DataNum >> 2);
  72   1        FLASH_Unlock();
  73   1        SetBit(WDT_CR, WDTRF);
  74   1        for(i=0;i<len;i++)
  75   1        {
  76   2          FLASHStatus = FLASH_ProgramWord(StartAddress, *((uint32_t*)pData));
  77   2          SetBit(WDT_CR, WDTRF);
  78   2          if (FLASHStatus == FLASH_COMPLETE)
  79   2          {
  80   3            StartAddress += 4;
  81   3            pData += 4;
  82   3          }
  83   2          else
  84   2          {
  85   3            FLASH_Lock();
  86   3            return FLASHStatus;
  87   3          }
  88   2        }
  89   1        FLASH_Lock();
  90   1        return FLASHStatus;
  91   1      }
  92          
  93          /**
  94            * @brief  擦出指定扇区区间的Flash数据 。
  95            * @param  StartPage 起始扇区地址
  96            * @param  EndPage 结束扇区地址
  97            * @retval 扇区擦出状态  
  98            */
  99          FLASH_Status CAN_BOOT_ErasePage(uint16_t StartPageAddr,uint16_t EndPageAddr)
 100          {
 101   1        uint16_t NbPages;
 102   1        uint16_t i=0,j=0;
 103   1        FLASH_Status FLASHStatus=FLASH_COMPLETE;
 104   1      
 105   1        /* ---- ① 参数扇区 0x0F00（不满 1 页，领导原文的页循环覆盖不到）---- */
 106   1        for(j = StartPageAddr; (j < EndPageAddr) && (j < APP_START_ADDR); j += 0x0100)
 107   1        {
 108   2          SetBit(WDT_CR, WDTRF);
 109   2          FLASHStatus = FLASH_EraseSector(j);
 110   2        }
 111   1      
 112   1        /* ---- ② APP 主体按 2KB 页擦（0x1000 ~ 0x77FF）---- */
 113   1        {
 114   2          uint16_t pageEnd = (EndPageAddr > 0x7800) ? 0x7800 : EndPageAddr;
 115   2          NbPages = (pageEnd - APP_START_ADDR) / 0x800;
C51 COMPILER V9.60.7.0   CAN_BOOTLOADER                                                    11/09/2026 13:00:53 PAGE 3   

 116   2      
 117   2          FLASH_Unlock();
 118   2          for(i = 0;i < NbPages;i++)
 119   2          {
 120   3            SetBit(WDT_CR, WDTRF);                       /* 原 delayus(100) */
 121   3            j = (APP_START_ADDR + (0x800 * i));
 122   3            FLASHStatus = FLASH_ErasePage(j);
 123   3          }
 124   2          FLASH_Lock();
 125   2        }
 126   1      
 127   1        /* ---- ③ 尾部 0x7800~0x7EFF（不满 1 页）---- */
 128   1        if(EndPageAddr > 0x7800)
 129   1        {
 130   2          for(j = 0x7800; j < EndPageAddr; j += 0x0100)
 131   2          {
 132   3            SetBit(WDT_CR, WDTRF);
 133   3            FLASHStatus = FLASH_EraseSector(j);
 134   3          }
 135   2        }
 136   1      
 137   1        return FLASHStatus;
 138   1      }
