  49          /**
  50            * @brief  将数据烧写到指定地址的Flash中 。
  51            * @param  Address Flash起始地址。
  52            * @param  Data 数据存储区起始地址。
  53            * @param  DataNum 数据字节数。
C51 COMPILER V9.60.7.0   CAN_BOOTLOADER                                                    11/13/2026 09:20:03 PAGE 2   

  54            * @retval 数据烧写状态。
  55            */
  56          FLASH_Status CAN_BOOT_ProgramDatatoFlash(uint16_t StartAddress,uint8_t *pData,uint16_t DataNum)
  57          {
  58   1        FLASH_Status FLASHStatus = FLASH_COMPLETE;
  59   1        uint16_t i=0,len=0;
  60   1      
  61   1        /* 地址校验以APP地址参考 */
  62   1        if(StartAddress < APP_EXE_FLAG_START_ADDR)
  63   1          return FLASH_ERROR_PG;
  64   1      
  65   1        /* 块固定 1024 字节（4 的倍数），按 4 字节写即可，与公司方案一致 */
  66   1        len = (uint16_t)(DataNum >> 2);
  67   1        FLASH_Unlock();
  68   1        SetBit(WDT_CR, WDTRF);
  69   1        for(i=0;i<len;i++)
  70   1        {
  71   2          FLASHStatus = FLASH_ProgramWord(StartAddress, *((uint32_t*)pData));
  72   2          SetBit(WDT_CR, WDTRF);
  73   2          if (FLASHStatus == FLASH_COMPLETE)
  74   2          {
  75   3            StartAddress += 4;
  76   3            pData += 4;
  77   3          }
  78   2          else
  79   2          {
  80   3            FLASH_Lock();
  81   3            return FLASHStatus;
  82   3          }
  83   2        }
  84   1        FLASH_Lock();
  85   1        return FLASHStatus;
  86   1      }
  87          
  88          /**
  89            * @brief  擦出指定扇区区间的Flash数据 。
  90            * @param  StartPage 起始扇区地址
  91            * @param  EndPage 结束扇区地址
  92            * @retval 扇区擦出状态  
  93            */
  94          FLASH_Status CAN_BOOT_ErasePage(uint16_t StartPageAddr,uint16_t EndPageAddr)
  95          {
  96   1        uint16_t NbPages;
  97   1        uint16_t i=0,j=0;
  98   1        FLASH_Status FLASHStatus=FLASH_COMPLETE;
  99   1      
 100   1        /* ---- ① 参数扇区 0x0F00（不满 1 页，领导原文的页循环覆盖不到）---- */
 101   1        for(j = StartPageAddr; (j < EndPageAddr) && (j < APP_START_ADDR); j += 0x0100)
 102   1        {
 103   2          SetBit(WDT_CR, WDTRF);
 104   2          FLASHStatus = FLASH_EraseSector(j);
 105   2        }
 106   1      
 107   1        /* ---- ② APP 主体按 2KB 页擦（0x1000 ~ 0x77FF）---- */
 108   1        {
 109   2          uint16_t pageEnd = (EndPageAddr > 0x7800) ? 0x7800 : EndPageAddr;
 110   2          NbPages = (pageEnd - APP_START_ADDR) / 0x800;
 111   2      
 112   2          FLASH_Unlock();
 113   2          for(i = 0;i < NbPages;i++)
 114   2          {
 115   3            SetBit(WDT_CR, WDTRF);                       /* 原 delayus(100) */
C51 COMPILER V9.60.7.0   CAN_BOOTLOADER                                                    11/13/2026 09:20:03 PAGE 3   

 116   3            j = (APP_START_ADDR + (0x800 * i));
 117   3            FLASHStatus = FLASH_ErasePage(j);
 118   3          }
 119   2          FLASH_Lock();
 120   2        }
 121   1      
 122   1        /* ---- ③ 尾部 0x7800~0x7EFF（不满 1 页）---- */
 123   1        if(EndPageAddr > 0x7800)
 124   1        {
 125   2          for(j = 0x7800; j < EndPageAddr; j += 0x0100)
 126   2          {
 127   3            SetBit(WDT_CR, WDTRF);
 128   3            FLASHStatus = FLASH_EraseSector(j);
 129   3          }
 130   2        }
 131   1      
 132   1        return FLASHStatus;
 133   1      }
