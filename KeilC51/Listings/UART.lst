  20          /* ==================== CAN 调试文本通道（DEBUG_UART_OR_CAN == 2 时启用）====================
  21           * printf 的字符先进 8 字节小缓冲，满 8 字节或遇到 '\n' 就发一帧标准帧 ID=CAN_DEBU
             -G_TEXT_ID。
  22           * 发送是“忙就丢”的非阻塞写法：CAN_SR.TXING 还高就整帧丢掉并计数，绝不进 CA
             -N_Send 里的
  23           * 超时等待 —— 否则总线对端不 ACK 时每帧都要空转上万次循环，主循环和 1ms �
             -��拍会被拖垮。
  24           * 纪律：printf 只能在主循环里调，任何中断里都不能进这里。
  25           */
  26          #if (DEBUG_UART_OR_CAN == 2)
              static uint8    xdata g_dbgTxBuf[8];
              static uint8    xdata g_dbgTxLen = 0;
              volatile uint16 xdata g_dbgTxDrop = 0;
              
              static void DebugCanFlush(void)
              {
                  if (g_dbgTxLen == 0)
                  {
                      return;
                  }
              
                  while (g_dbgTxLen < 8)                       /* 补 0 对齐 8 字节 */
                  {
                      g_dbgTxBuf[g_dbgTxLen++] = 0x00;
                  }
              
                  if (ReadBit(CAN_SR, TXING))                  /* 上一帧还没发完 → 丢这一帧，不阻塞 */
                  {
                      g_dbgTxDrop++;
                  }
                  else
                  {
                      (void)can_hw_send(CAN_DEBUG_TEXT_ID, g_dbgTxBuf, 8);
                  }
C51 COMPILER V9.60.7.0   UART                                                              10/27/2026 17:50:55 PAGE 2   

              
                  g_dbgTxLen = 0;
              }
              #endif
