 111   1          SetBit(PH_SEL , UART1EN);   /* UART1 端口复用总开关，转移后仍然要置 1 */
 112   1      
 113   1          /* ---- ② P1.0/P1.1 按普通数字口配置（这两脚默认是 LIN/高压脚）---- */
 114   1          ClrBit(P1_PU, P10HV_EN);    /* 关 P1.0 高压 PAD → 普通 TTL 电平 */
 115   1          ClrBit(P1_PU, P11HV_EN);    /* 关 P1.1 高压 PAD */
 116   1          SetBit(P1_OE, P10);         /* P1.0 = TXD → 输出使能（同 UART2_Init 对 P0.0 的写法）*/
 117   1          ClrBit(P1_OE, P11);         /* P1.1 = RXD → 输入 */
 118   1      
 119   1          /* ---- ③ UART1 本体：8bit UART，允许接收，不开中断（printf 轮询 TI）---- */
 120   1          UT_MOD1 = 0;                /* 00 单线8bit  01 8bit UART */
 121   1          UT_MOD0 = 1;
 122   1          SM2 = 0;
 123   1          REN = 1;
 124   1          TB8 = 0;
 125   1          RB8 = 0;
 126   1      
 127   1          ClrBit(IP3 , PI2C_UT11);    /* 中断优先级最低 */
 128   1          ClrBit(IP3 , PI2C_UT10);
 129   1      
 130   1          ClrBit(UT_BAUD , UART_2xBAUD);
 131   1          ES0 = 0;                    /* UART1 中断关：printf 只做查询发送 */
 132   1          /*  关键一句：bit12 UART_CH=1 → 端口转移；低 12 位 0x00C → 115200 8N1
 133   1             必须整字一次写！不能先 SetBit(UT_BAUD, UART_CH) 再写 0x000c，会被冲掉 */
 134   1          UT_BAUD = 0x100c;
 135   1      }
