  70   1          /*  新增：UART2 功能转移，TXD2/RXD2 由 P3.7/P3.6 挪到 P0.0/P0.1
  71   1             PH_SEL1.UART2CH1 = 1 → P37-->P00(TXD2S)   P36-->P01(RXD2S)
  72   1             见 FU68xx_6_MCU.h:1251  */
  73   1          SetBit(PH_SEL1, UART2CH1);
  74   1      
  75   1          /*  新增：RXD2(P0.1) 配成输入并软件上拉，避免悬空误触发起始位；
  76   1             TXD2(P0.0) 由 UART2 外设驱动，不用配输出使能 */
  77   1          ClrBit(P0_OE , P01);
  78   1          SetBit(P0_PU , P01);
  79   1          SetBit(P0_OE , P00);        /* ★ TXD2 = P0.0 输出使能（对照 dir_usart.c:74） */
  80   1      
  81   1      #if 0   /* P3.6/P3.7 已不用（板上接外部晶振），保留作参考 */
                  ClrBit(P3_OE , P36);        //输入使能
                  SetBit(P3_PU , P36);        //上拉电阻
                  SetBit(P3_OE , P37);        //输出使能            
                  SetBit(P3_PU , P37);        //上拉电阻  
              #endif
  87   1      
  88   1          ClrBit(UT2_CR , UT2MOD1); //00-->单线制8bit    01-->8bit uart(波特率可设置)
  89   1          SetBit(UT2_CR , UT2MOD0); //10-->单线制9bit      11-->9bit uart(波特率可设置)
  90   1      
  91   1          ClrBit(UT2_CR , UT2SM2);    //0-->单机通讯      1-->多机通讯；
  92   1          SetBit(UT2_CR , UT2REN);    //0-->不允许串行输入 1-->允许串行输入，软件清0;
  93   1          ClrBit(UT2_CR , UT2TB8);  //模式2/3下数据发送第9位，在多机通信中，可用于判断当�
             -�数据帧的数据是地址还是数据，TB8=0为数据，TB8=1为地址
  94   1          ClrBit(UT2_CR , UT2RB8);  //模式2/3下数据接收第9位，若SM2=0,作为停止位
  95   1      
  96   1          ClrBit(IP3 , PSPI_UT21);  //中断优先级时最低
  97   1          ClrBit(IP3 , PSPI_UT20);  //中断优先级时最低
  98   1      //    PSPI_UT21 = 0;              //中断优先级时最低
  99   1      //    PSPI_UT20 = 0;
 100   1      
 101   1          ClrBit(UT2_BAUD , BAUD2_SEL);//倍频使能0-->Disable  1-->Enable
 102   1      //    ClrBit(UT2_BAUD , UART2CH);  //UART2端口功能转移使能0：P36->RXD P37->TXD 1:P01->RXD P00->TX
