  20          /** 
  21           * @brief        Timer2初始化
  22           * @date         2022-09-13
  23           */
  24          void Timer2_Init(void)
  25          {
  26   1        SetBit(PH_SEL , T2SEL);     //P10
  27   1        SetBit(PH_SEL , T2SSEL);  //P07 
  28   1        ClrBit(TIM2_CR0 , T2PSC2);  //计数器时钟分频选择
  29   1        ClrBit(TIM2_CR0 , T2PSC1);  //000-->24M   001-->12M   010-->6M  011-->3M
  30   1        ClrBit(TIM2_CR0 , T2PSC0);  //100-->1.5M  101-->750K    110-->375K  111-->187.5K
  31   1        ClrBit(TIM2_CR0 , T2OCM);
  32   1        SetBit(TIM2_CR0 , T2IRE); //比较匹配中断/脉宽检测中断0-->Disable  1-->Enable
  33   1        ClrBit(TIM2_CR0 , T2CES); 
  34   1        
  35   1        ClrBit(TIM2_CR1 , T2IPE); //输入Timer PWM周期检测中断使能 0-->Disable  1-->Enable
  36   1        ClrBit(TIM2_CR1 , T2IFE); //计数器上溢中断使能 0-->Disable  1-->Enable
  37   1        ClrBit(TIM2_CR1 , T2FE);  //输入噪声滤波使能，小于4个时钟周期脉宽滤除
  38   1        ClrBit(TIM2_CR1 , T2DIR); //QEP&ISD&步进模式专用：当前的方向 0-->正向 1-->反向  
  39   1        
  40   1        TIM2__DR = 1200;
  41   1        TIM2__ARR = 2400;
  42   1          ClrBit(TIM2_CR0 , T2MOD1);  //00-->输入Timer模式        01-->输出模式
  43   1        SetBit(TIM2_CR0 , T2MOD0);  //10-->输入Counter模式      11-->QEP&ISD&步进模式
  44   1          SetBit(TIM2_CR1 , T2CEN); //TIM2使能  0-->Disable  1-->Enable
  45   1      }
