  54          void Timer3_Init(void)
  55          {
  56   1        SetBit(PH_SEL , T3SEL);     //Timer3端口使能
  57   1          ClrBit(PH_SEL1 , T3CT0);     //默认端口为P11,功能转移后为P01,需TIMER4转移到P00
  58   1          SetBit(P1_PU, P11HV_EN);  // P11 高压输入模式，保持使能，用于单线LIN电路
  59   1        
  60   1        SetBit(TIM3_CR0 , T3PSC2);  //计数器时钟分频选择
  61   1        SetBit(TIM3_CR0 , T3PSC1);  //000-->24M   001-->12M   010-->6M  011-->3M
  62   1        ClrBit(TIM3_CR0 , T3PSC0);  //100-->1.5M  101-->750K    110-->375K  111-->输入时为：48M
  63   1        
  64   1          ClrBit(TIM3_CR0 , T3OCM);
  65   1        SetBit(TIM3_CR0 , T3IRE); //比较匹配中断/脉宽检测中断0-->Disable  1-->Enable
  66   1        ClrBit(TIM3_CR0 , T3OPM); //0-->计数器不停止    1-->单次模式  
  67   1        
  68   1        SetBit(TIM3_CR1 , T3IPE); //输入Timer PWM周期检测中断使能 0-->Disable  1-->Enable
  69   1        SetBit(TIM3_CR1 , T3IFE); //计数器上溢中断使能 0-->Disable  1-->Enable
  70   1        ClrBit(TIM3_CR1 , T3NM1); //输入噪声脉宽选择
  71   1        ClrBit(TIM3_CR1 , T3NM0); //00-->不滤波  01-->4cycles    10-->8cycles  11-->16cycles
  72   1        
  73   1      //  TIM3__DR = 1200;
  74   1      //  TIM3__ARR = 2400;
  75   1          ClrBit(TIM3_CR0 , T3MOD);   //0-->Timer模式       1-->输出模式
  76   1          SetBit(TIM3_CR1 , T3EN);    //TIM3使能    0-->Disable  1-->Enable
  77   1      }
