 134          /**
 135           * 接收 ACK (返回 0 表示应答，非 0 表示无应答)
 136           */
 137          uint8_t SoftI2C_ReceiveACK(void) {
 138   1          uint8_t ack;
 139   1          I2C_SDA_H();   // 释放 SDA，等待从机拉低
 140   1          I2C_SCL_L();
 141   1          I2C_DELAY();
 142   1      
 143   1          I2C_SCL_H();
 144   1          I2C_DELAY();
 145   1      
 146   1          ack = I2C_SDA_READ();
 147   1      
 148   1          I2C_SCL_L();
 149   1          I2C_DELAY();
 150   1      
 151   1          return ack ? 1 : 0;
 152   1      }
