  58          /**
  59           * 发送一个字节
  60           */
  61          void SoftI2C_SendByte(uint8_t byte) {
  62   1          uint8_t i;
  63   1          for (i = 0; i < 8; i++) {
  64   2              I2C_SCL_L();
  65   2              if (byte & 0x80)
  66   2                  I2C_SDA_H();
  67   2              else
  68   2                  I2C_SDA_L();
  69   2              I2C_DELAY();
  70   2      
  71   2              I2C_SCL_H();
  72   2              I2C_DELAY();
  73   2              I2C_SCL_L();
  74   2              I2C_DELAY();
  75   2      
  76   2              byte <<= 1;
  77   2          }
  78   1      }
  79          
  80          /**
  81           * 接收一个字节（主机释放 SDA 后读取）
  82           */
  83          uint8_t SoftI2C_ReceiveByte(void) {
  84   1          uint8_t byte = 0;
  85   1          uint8_t i;
  86   1          I2C_SDA_H();   // 释放 SDA
  87   1          for (i = 0; i < 8; i++) {
  88   2              I2C_SCL_L();
  89   2              I2C_DELAY();
  90   2      
  91   2              I2C_SCL_H();
  92   2              I2C_DELAY();
  93   2      
  94   2              byte <<= 1;
  95   2              if (I2C_SDA_READ())
  96   2                  byte |= 0x01;
  97   2      
  98   2              I2C_SCL_L();
  99   2              I2C_DELAY();
 100   2          }
 101   1          return byte;
 102   1      }
