  15          /**
  16           * 初始化 IIC 总线引脚（FU6866 无开漏/推挽模式，只有方向 Px_OE + 数据位）
  17           *   高 = 输出 + 数据位 1；低 = 输出 + 数据位 0
  18           */
  19          void SoftI2C_Init(void)
  20          {
  21   1          GP44 = 1;
  22   1          /* SCL = P4.4：输出模式*/
  23   1          SetBit(P4_OE, P44);
  24   1      
  25   1          /* SDA = P0.4：输出模式*/
  26   1          GP04 = 1;
  27   1          SetBit(P0_OE, P04);
  28   1      
  29   1          I2C_SCL_H();
  30   1          I2C_SDA_H();
  31   1      }
  32          
  33          /**
  34           * 起始信号
  35           */
  36          void SoftI2C_Start(void) {
  37   1          I2C_SDA_H();
  38   1          I2C_SCL_H();
  39   1          I2C_DELAY();
  40   1      
  41   1          I2C_SDA_L();
  42   1          I2C_DELAY();
  43   1          I2C_SCL_L();   // 钳住总线
  44   1      }
  45          
  46          /**
  47           * 停止信号
  48           */
  49          void SoftI2C_Stop(void) {
  50   1          I2C_SDA_L();
  51   1          I2C_SCL_H();
  52   1          I2C_DELAY();
  53   1      
