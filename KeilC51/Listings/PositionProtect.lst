   1          /**
   2           * @file    PositionProtect.c
   3           * @brief   位置闭环的限位/堵转判断
   4           * @note    限位看位置，堵转看电流；两者分开，限位优先。
   5           */
   6          #include <MyProject.h>
   7          #include "PositionProtect.h"
   8          #include <math.h>
   9          
  10          #define POS_PROT_ABS_F(x)       (((x) < 0.0f) ? -(x) : (x))          /* 浮点绝对值 */
  11          #define POS_PROT_ABS_S16(x)     ((int16)(((x) < 0) ? -(x) : (x)))    /* int16 绝对值 */
  12          #define POS_PROT_STALL_CNT      (POS_STALL_CURRENT_MS / POS_CTRL_PERIOD_MS) /* 堵转确认需要的周期
             -数 */
  13          
  14          static uint16 xdata s_stallCnt;                 /* 堵转确认计数 */
  15          static float  xdata s_iqFilt;                   /* Iq 低通滤波值，单位 A */
  16          
  17          //
  18          uint8 PositionProtect_LimitCheck(float target, float fb, uint8 posActive)
  19          {
  20   1          if (!posActive)                              /* 不在位置模式，不判 */
  21   1          {
  22   2              return POS_PROTECT_NONE;
  23   2          }
  24   1      
  25   1          /* MAX：到软件上限，目标还要继续增大 → 立即限位 */
  26   1          if ((fb >= POS_LIMIT_MAX) && (target > fb))
  27   1          {
  28   2              return POS_PROTECT_LIMIT;
  29   2          }
  30   1      
  31   1          /* MIN：到软件下限，目标还要继续减小 → 立即限位 */
  32   1          if ((fb <= POS_LIMIT_MIN) && (target < fb))
  33   1          {
  34   2              return POS_PROTECT_LIMIT;
  35   2          }
  36   1      
  37   1          return POS_PROTECT_NONE;                     /* 没到限位，正常跑 */
  38   1      }
  39          
  40          /* ==================== 堵转判断 ==================== */
  41          /**
  42           * @brief  电流幅值堵转判断
  43           * @retval POS_PROTECT_STALL / POS_PROTECT_NONE
  44           * @note   任何 MOE=1 的状态都判，不看位置/闭环状态；
  45           *         但要求 |SpeedFlt| < POS_STALL_SPEED_RPM，避免高速大电流误判。
  46           *         用 sqrt(Id^2 + Iq^2)，不能只看 Iq：Id 大时会低估实际电流。
  47           */
  48          uint8 PositionProtect_StallCheck(void)
  49          {
  50   1          float id_a;                                  /* Id 实际电流，单位 A */
  51   1          float iq_a;                                  /* Iq 实际电流，单位 A */
  52   1          float i_mag;                                 /* 电流幅值，单位 A */
C51 COMPILER V9.60.7.0   POSITIONPROTECT                                                   10/27/2026 17:50:53 PAGE 2   

  53   1      
  54   1          if (MOE == 0)                                /* 输出没开，清状态即可 */
  55   1          {
  56   2              s_stallCnt = 0;
  57   2              s_iqFilt   = 0.0f;
  58   2              return POS_PROTECT_NONE;
  59   2          }
  60   1      
  61   1          /* Q15 -> A */
  62   1          id_a = (float)FOC__ID / 32767.0f * (float)HW_ADC_REF / ((float)HW_RSHUNT * (float)HW_AMPGAIN);
  63   1          iq_a = (float)FOC__IQ / 32767.0f * (float)HW_ADC_REF / ((float)HW_RSHUNT * (float)HW_AMPGAIN);
  64   1      
  65   1          i_mag = (float)sqrt((double)(id_a * id_a + iq_a * iq_a));
  66   1      
  67   1          /* 一阶低通，滤掉 PWM 开关尖峰 */
  68   1          s_iqFilt += POS_STALL_CURRENT_LPF * (i_mag - s_iqFilt);
  69   1      
  70   1          /* 堵转判据：电流超过阈值 + 转速接近 0，两个条件同时满足才计数 */
  71   1          if ((s_iqFilt > POS_STALL_CURRENT_A) && (POS_PROT_ABS_S16(mcFocCtrl.SpeedFlt) < S_Value(POS_STALL_SPEE
             -D_RPM)))
  72   1          {
  73   2              if (s_stallCnt < POS_PROT_STALL_CNT)
  74   2              {
  75   3                  s_stallCnt++;
  76   3              }
  77   2      
  78   2              if (s_stallCnt >= POS_PROT_STALL_CNT)    /* 30ms */
  79   2              {
  80   3                  printf("电机堵转\n");
  81   3                  return POS_PROTECT_STALL;
  82   3              }
  83   2          }
  84   1          else
  85   1          {
  86   2              s_stallCnt = 0;
  87   2          }
  88   1      
  89   1          return POS_PROTECT_NONE;
  90   1      }


