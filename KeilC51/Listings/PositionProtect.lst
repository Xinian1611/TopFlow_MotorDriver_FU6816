   1          /**
   2           * @file    PositionProtect.c
   3           * @brief   位置闭环的限位/堵转判断
   4           * @note    限位看位置，堵转看电流；两者分开，限位优先。
   5           */
   6          #include <MyProject.h>
   7          #include "PositionProtect.h"
   8          #include <math.h>
   9          
  10          #define POS_PROT_ABS_F(x)       (((x) < 0.0f) ? -(x) : (x))          /* 浮点绝对值 */
  11          #define POS_PROT_ABS_S16(x)     ((int16)(((x) < 0) ? -(x) : (x)))    /* int16 绝对值 */
  12          #define POS_PROT_STALL_CNT      (POS_STALL_CURRENT_MS / POS_CTRL_PERIOD_MS) /* 堵转确认需要的周期
             -数 */
  13          
  14          static uint16 xdata s_stallCnt;                 /* 堵转确认计数 */
  15          static float  xdata s_iqFilt;                   /* Iq 低通滤波值，单位 A */
  16          
  17          //
  18          uint8 PositionProtect_LimitCheck(float target, float fb, uint8 posActive)
  19          {
  20   1          if (!posActive)                              /* 不在位置模式，不判 */
  21   1          {
  22   2              return POS_PROTECT_NONE;
  23   2          }
  24   1      
  25   1          /* MAX：到软件上限，目标还要继续增大 → 立即限位 */
  26   1          if ((fb >= POS_LIMIT_MAX) && (target > fb))
  27   1          {
  28   2              return POS_PROTECT_LIMIT;
  29   2          }
  30   1      
  31   1          /* MIN：到软件下限，目标还要继续减小 → 立即限位 */
  32   1          if ((fb <= POS_LIMIT_MIN) && (target < fb))
  33   1          {
  34   2              return POS_PROTECT_LIMIT;
  35   2          }
  36   1      
  37   1          return POS_PROTECT_NONE;                     /* 没到限位，正常跑 */
  38   1      }
  39          
  40          /* ==================== 堵转判断 ==================== */
  41          /**
  42           * @brief  电流幅值堵转判断
  43           * @retval POS_PROTECT_STALL / POS_PROTECT_NONE
  44           * @note   任何 MOE=1 的状态都判，不看位置/速度/闭环状态。
  45           *         用 sqrt(Id^2 + Iq^2)，不能只看 Iq：Id 大时会低估实际电流。
  46           */
  47          uint8 PositionProtect_StallCheck(void)
  48          {
  49   1          float id_a;                                  /* Id 实际电流，单位 A */
  50   1          float iq_a;                                  /* Iq 实际电流，单位 A */
  51   1          float i_mag;                                 /* 电流幅值，单位 A */
  52   1      
C51 COMPILER V9.60.7.0   POSITIONPROTECT                                                   10/20/2026 17:28:31 PAGE 2   

  53   1          if (MOE == 0)                                /* 输出没开，清状态即可 */
  54   1          {
  55   2              s_stallCnt = 0;
  56   2              s_iqFilt   = 0.0f;
  57   2              return POS_PROTECT_NONE;
  58   2          }
  59   1      
  60   1          /* Q15 -> A */
  61   1          id_a = (float)FOC__ID / 32767.0f * (float)HW_ADC_REF / ((float)HW_RSHUNT * (float)HW_AMPGAIN);
  62   1          iq_a = (float)FOC__IQ / 32767.0f * (float)HW_ADC_REF / ((float)HW_RSHUNT * (float)HW_AMPGAIN);
  63   1      
  64   1          i_mag = (float)sqrt((double)(id_a * id_a + iq_a * iq_a));
  65   1      
  66   1          /* 一阶低通，滤掉 PWM 开关尖峰 */
  67   1          s_iqFilt += POS_STALL_CURRENT_LPF * (i_mag - s_iqFilt);
  68   1      
  69   1          if (s_iqFilt > POS_STALL_CURRENT_A)          /* 15A */
  70   1          {
  71   2              if (s_stallCnt < POS_PROT_STALL_CNT)
  72   2              {
  73   3                  s_stallCnt++;
  74   3              }
  75   2      
  76   2              if (s_stallCnt >= POS_PROT_STALL_CNT)    /* 30ms */
  77   2              {
  78   3                  return POS_PROTECT_STALL;
  79   3              }
  80   2          }
  81   1          else
  82   1          {
  83   2              s_stallCnt = 0;
  84   2          }
  85   1      
  86   1          return POS_PROTECT_NONE;
  87   1      }


