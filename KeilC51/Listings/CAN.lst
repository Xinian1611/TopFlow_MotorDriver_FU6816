 778          void can_dbg_poll(void)                 /* 1ms：每毫秒最多 1 帧，TXING 忙就跳过，绝不阻塞
             - */
 779          {
 780   1          if (g_dbgPage == 0) return;
 781   1          if (ReadBit(CAN_SR, TXING)) return;
 782   1      
 783   1          can_dbg_build(g_dbgPage);
 784   1          can_hw_send((uint32)(0x100 + g_dbgPage), g_dbgDat, CAN_FRAME_DATA_LEN);
 785   1      
 786   1          g_dbgPage++;
 787   1          if (g_dbgPage > CAN_DBG_PAGES) g_dbgPage = 0;
 788   1      }


