 768          void can_dbg_task(void)                 /* 1ms */
 769          {
 770   1          if (g_dbgPage != 0) return;         /* 上一轮还没发完，不重开 */
 771   1          if (++g_dbgTick >= CAN_DEBUG_PERIOD_MS)
 772   1          {
 773   2              g_dbgTick = 0;
 774   2              g_dbgPage = 1;
 775   2          }
