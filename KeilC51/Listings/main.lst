  54          /**
  55           * @brief     硬件初始化，初始化需要使用的硬件设备配置，FOC必须配置的是运放�
             -�压、运放初始化、ADC初始化、Driver初始化
  56           *            其他的可根据实际需求加。
  57           * @date      2022-07-14
  58           */
  59          void HardwareInit(void)
  60          {
  61   1          // 为提高芯片的抗干扰能力，降低芯片功耗，请在具体项目时，将不需要用的
             -GPIO默认都配置为输入上拉。
  62   1          //具体配置可在GPIO_Default_Init设置。
  63   1          //GPIO_Default_Init();
  64   1          /************************硬件外设初始化**************************/
  65   1          /* ADC参考电压电压配置 */
  66   1          VREFConfigInit();
  67   1          /*  硬件过流，比较器初始化，用于硬件过流比较保护  */
  68   1          CMP3_Init();
  69   1          /*  看门狗初始化 */
  70   1          WatchDogConfig(500);  
  71   1          /*  GPIO初始化 */    
  72   1          GPIO_Init();
  73   1          /* 先ADC初始化，后Driver初始化 */  
  74   1          ADC_Init();
  75   1          Driver_Init();
  76   1          /* 运放AMP初始化 */  
  77   1          AMP_Init();
  78   1          /* TIM3初始化，用于信号PWM捕获 */ 
  79   1          #if (SPEED_MODE == PWMMODE)
                  Timer3_Init();
                  #endif
  82   1          /* TSD温度传感器初始化 */
  83   1          TSD_Init();
  84   1          /*  比较器中断配置，与CMP3硬件配置间隔一段时间等待硬件稳定  */
  85   1          CMP3_Interrupt_Init();
  86   1          /* LIN初始化 */
  87   1          #if (SPEED_MODE == LINMODE)
                  LIN_Init();
                  #endif
  90   1      
  91   1        
  92   1        /*----- Can初始化 -----*/
  93   1        //CAN_Init();
  94   1          CanMin_Init();
  95   1          /*  SYSTICK定时器配置  */
  96   1          ClrBit(IP2, PSYSTICK1);    //1ms定时中断优先级别为1
  97   1          SetBit(IP2, PSYSTICK0);
  98   1          SetBit(DRV_SR, SYSTIE);
  99   1          EA = 1;
 100   1      }
