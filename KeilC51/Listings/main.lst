 117          /**
 118           * @brief        参考电压，偏置电压配置
 119           * @date         2022-07-14
 120           */
 121          void VREFConfigInit(void)
 122          {
 123   1          /************************VREF&VHALF Config************************/
 124   1          #if (HW_ADC_VREF == VREF3_0)
                  {
                      SetBit(VREF_VHALF_CR, VRVSEL1);             //00-->4.5V   01-->VDD5
                      ClrBit(VREF_VHALF_CR, VRVSEL0);             //10-->3.0V   11-->4.0V
                  }
                  #elif (HW_ADC_VREF == VREF4_0)
                  {
                      SetBit(VREF_VHALF_CR, VRVSEL1);             //00-->4.5V   01-->VDD5
                      SetBit(VREF_VHALF_CR, VRVSEL0);             //10-->3.0V   11-->4.0V
                  }
                  #elif (HW_ADC_VREF == VREF4_5)
 135   1          {
 136   2              ClrBit(VREF_VHALF_CR, VRVSEL1);             //00-->4.5V   01-->VDD5
 137   2              ClrBit(VREF_VHALF_CR, VRVSEL0);             //10-->3.0V   11-->4.0V
 138   2          }
 139   1          #elif (HW_ADC_VREF == VREF5_0)
                  {
                      ClrBit(VREF_VHALF_CR, VRVSEL1);             //00-->4.5V   01-->VDD5
                      SetBit(VREF_VHALF_CR, VRVSEL0);             //10-->3.0V   11-->4.0V
                  }
                  #endif
 145   1          // VHALF电压配置 00:1/8VREF  01:1/4VREF 10:25/64VREF 11:1/2VREF(default)
 146   1          #if (HW_VHALF_SEL == VHALF1_8)
                  ClrBit(VREF_VHALF_CR, VHALFSEL1);
                  ClrBit(VREF_VHALF_CR, VHALFSEL0);
                  #elif (HW_VHALF_SEL == VHALF1_4)
                  ClrBit(VREF_VHALF_CR, VHALFSEL1);
                  SetBit(VREF_VHALF_CR, VHALFSEL0);
                  #elif (HW_VHALF_SEL == VHALF25_64)
                  {
                      SetBit(VREF_VHALF_CR, VHALFSEL1);
                      ClrBit(VREF_VHALF_CR, VHALFSEL0);
                  }
                  #elif (HW_VHALF_SEL == VHALF1_2)
 158   1          {
 159   2              SetBit(VREF_VHALF_CR, VHALFSEL1);
 160   2              SetBit(VREF_VHALF_CR, VHALFSEL0);
 161   2          }
 162   1          #else
                  {
              #error " VHALF MODE Err "
                  }
                  #endif
 167   1          #if (VREF_OUT_EN)
 168   1          SetBit(P3_AN, P35);                         //VREF Voltage -->P35 Output 是否输出到P35引脚，�
             -�同步配置输出
 169   1          SetBit(P3_OE, P35);                         //VREF Voltage -->P35 Output 是否输出到P35引脚
 170   1          #endif
