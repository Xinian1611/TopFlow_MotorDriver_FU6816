 180          /**
 181           * @brief        主函数，大循环运行偏置电流采集函数，电机状态机控制函数，以�
             -�环路响应函数
 182           * @date         2022-07-14
 183           */
 184          void main(void)
 185          {
 186   1          uint16 PowerUpCnt = 0;
 187   1          
 188   1          /* ----- 上电空指令延时 等待系统稳定 ----- */
 189   1          for (PowerUpCnt = 0; PowerUpCnt < SystemPowerUpTime; PowerUpCnt++);
 190   1          
 191   1          /* ----- 部分变量初始化 ----- */
 192   1          SoftwareInit();
 193   1        
 194   1          /* ----- 硬件初始化，配置MCU外设 ----- */
 195   1          HardwareInit();
 196   1          /* ----- debug配置(SPI调试)，量产程序可以删除 ----- */
 197   1          DebugSet();
 198   1          /* ----- OTA：读参数页地址 + 清 IAP 状态 ----- */
 199   1          IAPData_Init();
 200   1          
 201   1          while (1)
 202   1          {
 203   2              /* ----- OTA：Check 应答 / cmd9 停机后擦标志复位 ----- */
 204   2              IAPRequestCheck();
 205   2      
 206   2              /* -----获取电流采样偏置电压----- */
 207   2              if (!mcCurOffset.OffsetFlag)
 208   2              {
 209   3                  GetCurrentOffset();
 210   3              }
 211   2              else
 212   2              {
 213   3                  /* -----电机控制状态机----- */
 214   3                  MC_Control();
 215   3              }
 216   2              
 217   2              /* -----1ms处理函数----- */
 218   2              if (g_1mTick)
 219   2              {
 220   3                  GP12 = ~GP12;       //FICD,下载口复用为GPIO测试引脚 
 221   3                  WatchDogRefresh();  //喂狗,若不喂狗则MCU复位
 222   3                  TickCycle_1ms();
 223   3                  CanMin_Poll();          /* 最小 CAN：收指令 + 发日志 */
 224   3                  IAPTick1ms();           /* OTA 握手 3s + 停机等待 3s 倒计时 */
 225   3                  g_1mTick = 0;
 226   3              }
 227   2          }
 228   1      }


