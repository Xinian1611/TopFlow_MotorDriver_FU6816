 178          /**
 179           * @brief        主函数，大循环运行偏置电流采集函数，电机状态机控制函数，以�
             -�环路响应函数
 180           * @date         2022-07-14
 181           */
 182          void main(void)
 183          {
 184   1          uint16 PowerUpCnt = 0;
 185   1          
 186   1          /* ----- 上电空指令延时 等待系统稳定 ----- */
 187   1          for (PowerUpCnt = 0; PowerUpCnt < SystemPowerUpTime; PowerUpCnt++);
 188   1          
 189   1          /* ----- 部分变量初始化 ----- */
 190   1          SoftwareInit();
 191   1        
 192   1          /* ----- 硬件初始化，配置MCU外设 ----- */
 193   1          HardwareInit();
 194   1          /* ----- debug配置(SPI调试)，量产程序可以删除 ----- */
 195   1          DebugSet();
 196   1          
 197   1          while (1)
 198   1          {
 199   2              /* -----获取电流采样偏置电压----- */
 200   2              if (!mcCurOffset.OffsetFlag)
 201   2              {
 202   3                  GetCurrentOffset();
 203   3              }
 204   2              else
 205   2              {
 206   3                  /* -----电机控制状态机----- */
 207   3                  MC_Control();
 208   3              }
 209   2              
 210   2              /* -----1ms处理函数----- */
 211   2              if (g_1mTick)
 212   2              {
 213   3                  GP12 = ~GP12;       //FICD,下载口复用为GPIO测试引脚 
 214   3                  WatchDogRefresh();  //喂狗,若不喂狗则MCU复位
 215   3                  TickCycle_1ms();
 216   3                  g_1mTick = 0;
 217   3              }
 218   2          }
 219   1      }


