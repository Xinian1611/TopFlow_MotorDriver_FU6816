  53          /**
  54           * @brief     硬件初始化，初始化需要使用的硬件设备配置，FOC必须配置的是运放�
             -�压、运放初始化、ADC初始化、Driver初始化
  55           *            其他的可根据实际需求加。
  56           * @date      2022-07-14
  57           */
  58          void HardwareInit(void)
  59          {
  60   1          // 为提高芯片的抗干扰能力，降低芯片功耗，请在具体项目时，将不需要用的
             -GPIO默认都配置为输入上拉。
  61   1          //具体配置可在GPIO_Default_Init设置。
  62   1          //GPIO_Default_Init();
  63   1          /************************硬件外设初始化**************************/
  64   1          /* ADC参考电压电压配置 */
  65   1          VREFConfigInit();
  66   1          /*  硬件过流，比较器初始化，用于硬件过流比较保护  */
  67   1          CMP3_Init();
  68   1          /*  看门狗初始化 */
  69   1          WatchDogConfig(500);  
  70   1          /*  GPIO初始化 */    
  71   1          GPIO_Init();
  72   1          /* 先ADC初始化，后Driver初始化 */  
  73   1          ADC_Init();
  74   1          Driver_Init();
  75   1          /* 运放AMP初始化 */  
  76   1          AMP_Init();
  77   1          /* TIM3初始化，用于信号PWM捕获 */ 
  78   1          #if (SPEED_MODE == PWMMODE)
                  Timer3_Init();
                  #endif
  81   1          /* TSD温度传感器初始化 */
  82   1          TSD_Init();
  83   1          /*  比较器中断配置，与CMP3硬件配置间隔一段时间等待硬件稳定  */
  84   1          CMP3_Interrupt_Init();
  85   1          /* LIN初始化 */
  86   1          #if (SPEED_MODE == LINMODE)
                  LIN_Init();
                  #endif
  89   1      
  90   1        
  91   1        /*----- Can初始化 -----*/
  92   1        //CAN_Init();
  93   1          CanMin_Init();
  94   1          /*  SYSTICK定时器配置  */
  95   1          ClrBit(IP2, PSYSTICK1);    //1ms定时中断优先级别为1
  96   1          SetBit(IP2, PSYSTICK0);
  97   1          SetBit(DRV_SR, SYSTIE);
  98   1          EA = 1;
  99   1      }
