 179          /**
 180           * @brief        主函数，大循环运行偏置电流采集函数，电机状态机控制函数，以�
             -�环路响应函数
 181           * @date         2022-07-14
 182           */
 183          void main(void)
 184          {
 185   1          uint16 PowerUpCnt = 0;
 186   1          
 187   1          /* ----- 上电空指令延时 等待系统稳定 ----- */
 188   1          for (PowerUpCnt = 0; PowerUpCnt < SystemPowerUpTime; PowerUpCnt++);
 189   1          
 190   1          /* ----- 部分变量初始化 ----- */
 191   1          SoftwareInit();
 192   1        
 193   1          /* ----- 硬件初始化，配置MCU外设 ----- */
 194   1          HardwareInit();
 195   1          /* ----- debug配置(SPI调试)，量产程序可以删除 ----- */
 196   1          DebugSet();
 197   1          
 198   1          while (1)
 199   1          {
 200   2              /* -----获取电流采样偏置电压----- */
 201   2              if (!mcCurOffset.OffsetFlag)
 202   2              {
 203   3                  GetCurrentOffset();
 204   3              }
 205   2              else
 206   2              {
 207   3                  /* -----电机控制状态机----- */
 208   3                  MC_Control();
 209   3              }
 210   2              
 211   2              /* -----1ms处理函数----- */
 212   2              if (g_1mTick)
 213   2              {
 214   3                  GP12 = ~GP12;       //FICD,下载口复用为GPIO测试引脚 
 215   3                  WatchDogRefresh();  //喂狗,若不喂狗则MCU复位
 216   3                  TickCycle_1ms();
 217   3                  CanMin_Poll();          /* 最小 CAN：收指令 + 发日志 */
 218   3                  g_1mTick = 0;
 219   3              }
 220   2          }
 221   1      }


