  35          static void DebugSet(void)
  36          {
  37   1          #if (DBG_MODE ==  DBG_SPI_HW)      // 硬件调试模式
                  SPI_Init();
                  Set_DBG_DMA(&HARD_SPIDATA);
                  #elif (DBG_MODE ==  DBG_SPI_SW)   // 软件调试模式
                  SPI_Init();
                  Set_DBG_DMA(spidebug);
                  #elif (DBG_MODE ==  DBG_UART)
                  UART2_Init();
                  Conf_DMA(1, XDATA_UART1, (uint16)GetAddr_UARTDBG(), BUFFLEN);
                #elif (DBG_MODE ==  DBG_UART)
                  _nop_;
                  #endif
  49   1        
  50   1            /*******************Observation signal Select*********************/
  51   1          SetReg(CMP_CR3, DBGSEL0 | DBGSEL1, GP01_DBG_Conf);
  52   1      }
