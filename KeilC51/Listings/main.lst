 116          /**
 117           * @brief        参考电压，偏置电压配置
 118           * @date         2022-07-14
 119           */
 120          void VREFConfigInit(void)
 121          {
 122   1          /************************VREF&VHALF Config************************/
 123   1          #if (HW_ADC_VREF == VREF3_0)
                  {
                      SetBit(VREF_VHALF_CR, VRVSEL1);             //00-->4.5V   01-->VDD5
                      ClrBit(VREF_VHALF_CR, VRVSEL0);             //10-->3.0V   11-->4.0V
                  }
                  #elif (HW_ADC_VREF == VREF4_0)
                  {
                      SetBit(VREF_VHALF_CR, VRVSEL1);             //00-->4.5V   01-->VDD5
                      SetBit(VREF_VHALF_CR, VRVSEL0);             //10-->3.0V   11-->4.0V
                  }
                  #elif (HW_ADC_VREF == VREF4_5)
 134   1          {
 135   2              ClrBit(VREF_VHALF_CR, VRVSEL1);             //00-->4.5V   01-->VDD5
 136   2              ClrBit(VREF_VHALF_CR, VRVSEL0);             //10-->3.0V   11-->4.0V
 137   2          }
 138   1          #elif (HW_ADC_VREF == VREF5_0)
                  {
                      ClrBit(VREF_VHALF_CR, VRVSEL1);             //00-->4.5V   01-->VDD5
                      SetBit(VREF_VHALF_CR, VRVSEL0);             //10-->3.0V   11-->4.0V
                  }
                  #endif
 144   1          // VHALF电压配置 00:1/8VREF  01:1/4VREF 10:25/64VREF 11:1/2VREF(default)
 145   1          #if (HW_VHALF_SEL == VHALF1_8)
                  ClrBit(VREF_VHALF_CR, VHALFSEL1);
                  ClrBit(VREF_VHALF_CR, VHALFSEL0);
                  #elif (HW_VHALF_SEL == VHALF1_4)
                  ClrBit(VREF_VHALF_CR, VHALFSEL1);
                  SetBit(VREF_VHALF_CR, VHALFSEL0);
                  #elif (HW_VHALF_SEL == VHALF25_64)
                  {
                      SetBit(VREF_VHALF_CR, VHALFSEL1);
                      ClrBit(VREF_VHALF_CR, VHALFSEL0);
                  }
                  #elif (HW_VHALF_SEL == VHALF1_2)
 157   1          {
 158   2              SetBit(VREF_VHALF_CR, VHALFSEL1);
 159   2              SetBit(VREF_VHALF_CR, VHALFSEL0);
 160   2          }
 161   1          #else
                  {
              #error " VHALF MODE Err "
                  }
                  #endif
 166   1          #if (VREF_OUT_EN)
 167   1          SetBit(P3_AN, P35);                         //VREF Voltage -->P35 Output 是否输出到P35引脚，�
             -�同步配置输出
 168   1          SetBit(P3_OE, P35);                         //VREF Voltage -->P35 Output 是否输出到P35引脚
 169   1          #endif
 170   1          #if (VHALF_OUT_EN)
 171   1          SetBit(P3_AN, P32);
 172   1          #endif
 173   1          SetBit(VREF_VHALF_CR, VREFEN | VHALFEN);    //VREF_VHALF_CR = 0x11;
