 483          /* ==========================================================================
 484           *  八、状态帧组帧
 485           * --------------------------------------------------------------------------
 486           *  对应 20261030 CanSlave.c 的 ext_build_status()，字节定义见 CanProtocol.h：
C51 COMPILER V9.60.7.0   CANMIN                                                            11/13/2026 09:18:17 PAGE 9   

 487           *      Byte0    ctrl：工作模式 + 启停 + 急停 回显
 488           *      Byte1-2  实际转速（1rpm，32767=0，负=反转）
 489           *      Byte3-4  相电流（0.01A，32767=0）
 490           *      Byte5-6  功率（1W，32767=0）
 491           *      Byte7    故障码（0xFF=无故障）
 492           * ========================================================================== */
 493          static void CanMin_BuildStatus(uint8 *buf)
 494          {
 495   1          ExtStatusMsg_t *msg;
 496   1          int16 speed;
 497   1          int16 current;
 498   1          int16 power;
 499   1          uint8 ctrl;
 500   1      
 501   1          msg = (ExtStatusMsg_t *)buf;
 502   1          memset(msg, 0xFF, sizeof(ExtStatusMsg_t));
 503   1      
 504   1          /* ---- Byte0: ctrl 回显 ---- */
 505   1          ctrl = 0;
 506   1          EXT_SET_WORKMODE(ctrl, g_run_state.work_mode);
 507   1          EXT_SET_STARTSTOP(ctrl, (g_run_state.is_started != 0) ? EXT_STARTSTOP_START : EXT_STARTSTOP_STOP);
 508   1          EXT_SET_ESTOP(ctrl, (g_run_state.is_estop != 0) ? EXT_ESTOP_ACTIVE : EXT_ESTOP_RELEASE);
 509   1          msg->ctrl.value = ctrl;
 510   1      
 511   1          /* ---- Byte1-2: 实际转速 ---- */
 512   1          speed = (int16)CANMIN_S2F(mcFocCtrl.SpeedFlt);
 513   1          if (mcFocCtrl.FR == CCW)
 514   1          {
 515   2              speed = -speed;                         /* 协议：负值 = 反转 */
 516   2          }
 517   1          EXT_SET_I16(msg->speed_hi, msg->speed_lo, speed + 32767);
 518   1      
 519   1          /* ---- Byte3-4: 相电流（Q轴电流，0.01A） ---- */
 520   1          current = (int16)(CANMIN_I2F(FOC__IQ) * 100.0f);
 521   1          EXT_SET_I16(msg->current_hi, msg->current_lo, current + 32767);
 522   1      
 523   1          /* ---- Byte5-6: 功率（1W） ---- */
 524   1          power = mcFocCtrl.PowerFlt;
 525   1          EXT_SET_I16(msg->power_hi, msg->power_lo, power + 32767);
 526   1      
 527   1          /* ---- Byte7: 故障码 ----
 528   1           * 优先上报通信超时置的 g_run_state.fault_code（0x87 = 三级/通信异常停机）；
 529   1           * 其次是电机故障（mcFaultSource 非 0 时粗报 0x80）；
 530   1           * 都没有就是 0xFF。具体故障码可在 Keil 里看 mcFaultSource。 */
 531   1          if (g_run_state.fault_code != FAULT_NONE)
 532   1          {
 533   2              msg->fault_code = g_run_state.fault_code;
 534   2          }
 535   1          else if (mcFaultSource != FaultNoSource)
 536   1          {
 537   2              msg->fault_code = FAULT_BUILD(FAULT_LEVEL_3, 0);
 538   2          }
 539   1          else
 540   1          {
 541   2              msg->fault_code = FAULT_NONE;
 542   2          }
 543   1      }
