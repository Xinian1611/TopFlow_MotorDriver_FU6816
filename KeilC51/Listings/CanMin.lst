 545          /* ==========================================================================
 546           *  九、发送
 547           * --------------------------------------------------------------------------
 548           *  对应 20261030 的 CAN_Send()，区别是“非阻塞”：
C51 COMPILER V9.60.7.0   CANMIN                                                            11/13/2026 09:18:17 PAGE 10  

 549           *     - g_canmin_tx_ready=0 表示上一帧还没发完（TXSUC=0），本周期直接跳过；
 550           *     - 等待超过 CAN_TX_TIMEOUT_MS 强制认为空闲，避免一次失败后永远不发；
 551           *     - 写 TXCR/TXID/TXDR 的字节顺序与 20261030 完全一致。
 552           * ========================================================================== */
 553          static uint8 CanMin_Send(void)
 554          {
 555   1          /* ---- 上一帧是否已发完 ---- */
 556   1          if (!g_canmin_tx_ready)
 557   1          {
 558   2              if (ReadBit(CAN_SR, TXSUC))
 559   2              {
 560   3                  g_canmin_tx_ready = 1;
 561   3                  g_canmin_tx_wait  = 0;
 562   3              }
 563   2              else if (g_canmin_tx_wait >= CAN_TX_TIMEOUT_MS)
 564   2              {
 565   3                  g_canmin_tx_ready = 1;              /* 超时强制重发 */
 566   3                  g_canmin_tx_wait  = 0;
 567   3              }
 568   2              else
 569   2              {
 570   3                  g_canmin_stat.TxSkip++;
 571   3                  return 0;
 572   3              }
 573   2          }
 574   1      
 575   1          /* ---- 控制字：IDE | RTR | DLC ---- */
 576   1          CAN_TXCR  = CanMinSend.CAN_IDE | CanMinSend.CAN_RTR | CanMinSend.CAN_DLC;
 577   1      
 578   1          /* ---- 29 位扩展 ID（或 11 位标准 ID） ---- */
 579   1          if (CanMinSend.CAN_IDE)
 580   1          {
 581   2              CAN_TXID0 = (uint8)(CanMinSend.EXTID >> 21);
 582   2              CAN_TXID1 = (uint8)(CanMinSend.EXTID >> 13);
 583   2              CAN_TXID2 = (uint8)(CanMinSend.EXTID >> 5);
 584   2              CAN_TXID3 = (uint8)(CanMinSend.EXTID << 3);   /* 20261030 这里也是 <<3 */
 585   2          }
 586   1          else
 587   1          {
 588   2              CAN_TXID0 = (uint8)(CanMinSend.STDID >> 3);
 589   2              CAN_TXID1 = (uint8)(CanMinSend.STDID << 5);
 590   2              CAN_TXID2 = 0;
 591   2              CAN_TXID3 = 0;
 592   2          }
 593   1      
 594   1          /* ---- 8 字节数据 ---- */
 595   1          CAN_TXDR0 = CanMinSend.Data0;
 596   1          CAN_TXDR1 = CanMinSend.Data1;
 597   1          CAN_TXDR2 = CanMinSend.Data2;
 598   1          CAN_TXDR3 = CanMinSend.Data3;
 599   1          CAN_TXDR4 = CanMinSend.Data4;
 600   1          CAN_TXDR5 = CanMinSend.Data5;
 601   1          CAN_TXDR6 = CanMinSend.Data6;
 602   1          CAN_TXDR7 = CanMinSend.Data7;
 603   1      
 604   1          /* ---- 启动发送 ---- */
 605   1          ClrBit(CAN_IFR, TXIF);
 606   1          SetBit(CAN_CR1, TXREQ);
 607   1      
 608   1          g_canmin_tx_ready = 0;
 609   1          g_canmin_tx_wait  = 0;
 610   1          g_canmin_stat.TxFrames++;
C51 COMPILER V9.60.7.0   CANMIN                                                            11/13/2026 09:18:17 PAGE 11  

 611   1          return 1;
 612   1      }
