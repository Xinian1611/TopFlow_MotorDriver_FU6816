 544          /* ==========================================================================
 545           *  九、发送
 546           * --------------------------------------------------------------------------
 547           *  对应 20261030 的 CAN_Send()，区别是“非阻塞”：
 548           *     - g_canmin_tx_ready=0 表示上一帧还没发完（TXSUC=0），本周期直接跳过；
C51 COMPILER V9.60.7.0   CANMIN                                                            11/11/2026 10:23:48 PAGE 10  

 549           *     - 等待超过 CAN_TX_TIMEOUT_MS 强制认为空闲，避免一次失败后永远不发；
 550           *     - 写 TXCR/TXID/TXDR 的字节顺序与 20261030 完全一致。
 551           * ========================================================================== */
 552          static uint8 CanMin_Send(void)
 553          {
 554   1          /* ---- 上一帧是否已发完 ---- */
 555   1          if (!g_canmin_tx_ready)
 556   1          {
 557   2              if (ReadBit(CAN_SR, TXSUC))
 558   2              {
 559   3                  g_canmin_tx_ready = 1;
 560   3                  g_canmin_tx_wait  = 0;
 561   3              }
 562   2              else if (g_canmin_tx_wait >= CAN_TX_TIMEOUT_MS)
 563   2              {
 564   3                  g_canmin_tx_ready = 1;              /* 超时强制重发 */
 565   3                  g_canmin_tx_wait  = 0;
 566   3              }
 567   2              else
 568   2              {
 569   3                  g_canmin_stat.TxSkip++;
 570   3                  return 0;
 571   3              }
 572   2          }
 573   1      
 574   1          /* ---- 控制字：IDE | RTR | DLC ---- */
 575   1          CAN_TXCR  = CanMinSend.CAN_IDE | CanMinSend.CAN_RTR | CanMinSend.CAN_DLC;
 576   1      
 577   1          /* ---- 29 位扩展 ID（或 11 位标准 ID） ---- */
 578   1          if (CanMinSend.CAN_IDE)
 579   1          {
 580   2              CAN_TXID0 = (uint8)(CanMinSend.EXTID >> 21);
 581   2              CAN_TXID1 = (uint8)(CanMinSend.EXTID >> 13);
 582   2              CAN_TXID2 = (uint8)(CanMinSend.EXTID >> 5);
 583   2              CAN_TXID3 = (uint8)(CanMinSend.EXTID << 3);   /* 20261030 这里也是 <<3 */
 584   2          }
 585   1          else
 586   1          {
 587   2              CAN_TXID0 = (uint8)(CanMinSend.STDID >> 3);
 588   2              CAN_TXID1 = (uint8)(CanMinSend.STDID << 5);
 589   2              CAN_TXID2 = 0;
 590   2              CAN_TXID3 = 0;
 591   2          }
 592   1      
 593   1          /* ---- 8 字节数据 ---- */
 594   1          CAN_TXDR0 = CanMinSend.Data0;
 595   1          CAN_TXDR1 = CanMinSend.Data1;
 596   1          CAN_TXDR2 = CanMinSend.Data2;
 597   1          CAN_TXDR3 = CanMinSend.Data3;
 598   1          CAN_TXDR4 = CanMinSend.Data4;
 599   1          CAN_TXDR5 = CanMinSend.Data5;
 600   1          CAN_TXDR6 = CanMinSend.Data6;
 601   1          CAN_TXDR7 = CanMinSend.Data7;
 602   1      
 603   1          /* ---- 启动发送 ---- */
 604   1          ClrBit(CAN_IFR, TXIF);
 605   1          SetBit(CAN_CR1, TXREQ);
 606   1      
 607   1          g_canmin_tx_ready = 0;
 608   1          g_canmin_tx_wait  = 0;
 609   1          g_canmin_stat.TxFrames++;
 610   1          return 1;
C51 COMPILER V9.60.7.0   CANMIN                                                            11/11/2026 10:23:48 PAGE 11  

 611   1      }
