 774   2              CanMin_ReadFrame();                     /* 读出最老的一帧到 CanMin */
 775   2              SetBit(CAN_CR1, BUFRLS);                /* 释放该接收缓冲 */
 776   2              ClrBit(CAN_IFR, RXIF);                  /* 清接收标志（无中断，清一下更干净） */
 777   2      
 778   2              g_canmin_stat.RxFrames++;
