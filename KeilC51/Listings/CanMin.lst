   1          /**
   2           * @file      CanMin.c
   3           * @brief     最小 CAN 功能验证模块（无中断、纯轮询）
   4           *  设计要点
   5           * ----------------------------------------------------------------------------
   6           *   1. 不使用 CAN 中断：
   7           *        20261030 是 SetBit(CAN_IER, ...RXIE|TXIE|...) + Interrupt.c 的
   8           *        CAN_INT(interrupt 8) 中断收帧；本模块把 CAN_IER 全部写 0，
   9           *        在 1ms 任务里轮询 CAN_SR.NOEMP 收帧。两条路径完全独立，
  10           *        原 CAN.c / CAN.h / Interrupt.c 一行未改。
  11           *
  12           *   2. 只有两类报文：
  13           *        指令 0x042CF081（8 字节，优先级 2，主机 -> 驱动板）
  14           *        状态 0x062CF081（8 字节，优先级 3，驱动板 -> 主机，150ms）
  15           *
  16           *   3. 过滤器放行全部扩展帧，地址在软件层比对（和 20261030 的 CAN_Init 一样）。
  17           *
  18           *   4. 发送非阻塞：
  19           *        20261030 的 CAN_Send() 是 while(!TXSUC) 死等（10000 次超时）；
  20           *        本模块上一帧没发完就跳过本周期，另加 CAN_TX_TIMEOUT_MS 超时重发，
  21           *        保证 1ms 任务绝不被 CAN 发送拖住。
  22           *
  23           *   5. 控制映射与 20261030 的 TargetRef_Process() CANMODE 分支一致：
  24           *        急停 -> Ref=0、isCtrlPowOn=0；
  25           *        起机/停机 -> isCtrlPowOn = g_run_state.is_started；
  26           *        换向 -> 先减速到 50rpm 以下再切 mcFocCtrl.FR；
  27           *        目标 -> mcFocCtrl.Ref = S_Value(g_run_state.ref)。
  28           * ============================================================================
  29           */
  30          
  31          #include <MyProject.h>
  32          #include <string.h>
  33          
  34          /* ==========================================================================
  35           *  一、工程量换算（与 20261030 的 CanSlave.c 完全一致）
  36           * ========================================================================== */
  37          /* 速度：Q15 -> rpm。
  38           * mcFocCtrl.SpeedFlt 是 Q15（32767 对应 MOTOR_SPEED_BASE = 4096rpm），
  39           * 除以 32767 再乘基准，就是实际转速。 */
  40          #define CANMIN_S2F(x)   ((float)(x) / 32767.0f * MOTOR_SPEED_BASE)
  41          
  42          /* 电流：Q15 -> A。
  43           * 电流采样链路的满量程 = HW_ADC_REF / (HW_RSHUNT * HW_AMPGAIN)，
  44           * 本板：4.5V / (0.001Ω * 16) = 281.25A（对应 32767）。 */
  45          #define CANMIN_I2F(x)   ((float)(x) / 32767.0f * (float)HW_ADC_REF / ((float)HW_RSHUNT * (float)HW_AMPGAIN
             -))
  46          
  47          /* 母线电压：Q15 -> V。满量程 = HW_BOARD_VOLT_MAX（由分压电阻决定）。 */
  48          #define CANMIN_U2F(x)   ((float)(x) / 32767.0f * (float)HW_BOARD_VOLT_MAX)
  49          
