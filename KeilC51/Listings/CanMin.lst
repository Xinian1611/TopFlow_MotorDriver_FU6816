 324   1          /* ---- ③ 启停：1=起机 2=停机；0=无操作、3=无效值 -> 保持原状态 ---- */
 325   1          if (startstop == EXT_STARTSTOP_START)
 326   1          {
 327   2              CanMin_SetRun(1);
