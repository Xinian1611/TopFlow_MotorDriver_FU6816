 861          /* ==========================================================================
 862           *  十三、指令 -> 电机给定
 863           * --------------------------------------------------------------------------
 864           *  对应 20261030 AddFunction.c 里 TargetRef_Process() 的 CANMODE 分支。
 865           *  调用位置：TickCycle_1ms() 中 TargetRef_Process() 之后、Speed_response() 之前。
 866           *  这一步不能省：NONEMODE 分支每 1ms 会把 mcFocCtrl.Ref 写成 0，
 867           *  必须在这之后把 CAN 的目标值覆盖回去。
 868           * ========================================================================== */
 869          void CanMin_ApplyCmd(void)
 870          {
 871   1          uint8 target_fr;
 872   1          int16 speed_abs;
 873   1      
 874   1          /* 起机/停机：直接决定 isCtrlPowOn，MC_Control() 据此走 mcInit / mcStop */
 875   1          isCtrlPowOn = g_run_state.is_started;
 876   1      
 877   1          /* 急停：给定清零 + 进入停机，并清掉换向状态 */
 878   1          if (g_run_state.is_estop)
 879   1          {
 880   2              mcFocCtrl.Ref = 0;
 881   2              isCtrlPowOn   = false;
 882   2              g_run_state.is_started       = 0;
 883   2              g_run_state.reversal_braking = 0;
 884   2          }
 885   1      
 886   1          /* 目标方向：0=CW 1=CCW */
 887   1          target_fr = (g_run_state.direction == CW) ? CW : CCW;
 888   1      
 889   1          if (g_run_state.reversal_braking)
 890   1          {
 891   2              /* ---- 换向减速中 ----
 892   2               * 退出条件：方向已一致 / 已停机 / 目标为 0；或者实际转速已降到 50rpm �
             -�下。 */
 893   2              if ((target_fr == mcFocCtrl.FR) ||
 894   2                  (g_run_state.is_started == 0) ||
 895   2                  (g_run_state.ref == 0))
 896   2              {
 897   3                  g_run_state.reversal_braking = 0;
 898   3              }
 899   2              else
 900   2              {
 901   3                  speed_abs = mcFocCtrl.SpeedFlt;
 902   3                  if (speed_abs < 0)
 903   3                  {
 904   4                      speed_abs = -speed_abs;
 905   4                  }
 906   3      
 907   3                  if (speed_abs < S_Value(50.0))
 908   3                  {
 909   4                      /* 减速到位，切方向，下一周期开始按新方向加速 */
 910   4                      g_run_state.reversal_braking = 0;
 911   4                      mcFocCtrl.FR                 = g_run_state.direction;
 912   4                  }
 913   3              }
 914   2          }
 915   1          else
 916   1          {
 917   2              /* ---- 正常模式：检测是否需要启动换向减速 ----
 918   2               * 条件：目标方向变了、正在运行、没急停、目标不为 0、当前速度 >= 50rpm
             -。 */
C51 COMPILER V9.60.7.0   CANMIN                                                            11/11/2026 10:23:48 PAGE 16  

 919   2              if ((target_fr != mcFocCtrl.FR) &&
 920   2                  g_run_state.is_started &&
 921   2                  (!g_run_state.is_estop) &&
 922   2                  (g_run_state.ref > 0))
 923   2              {
 924   3                  speed_abs = mcFocCtrl.SpeedFlt;
 925   3                  if (speed_abs < 0)
 926   3                  {
 927   4                      speed_abs = -speed_abs;
 928   4                  }
 929   3      
 930   3                  if (speed_abs >= S_Value(50.0))
 931   3                  {
 932   4                      g_run_state.reversal_braking = 1;
 933   4                      mcState                      = mcStop;   /* 与 20261030 的 CANMODE 分支一致 */
 934   4                  }
 935   3              }
 936   2      
 937   2              /* ---- 应用目标值 ----
 938   2               * 转速模式：g_run_state.ref 是 rpm，转成 Q15 给速度环。
 939   2               * 电流模式：最小版不支持（见 CanMin_SetMode），这里不会进来。 */
 940   2              if (g_run_state.work_mode == EXT_WORK_MODE_SPEED)
 941   2              {
 942   3                  mcFocCtrl.Ref = S_Value(g_run_state.ref);
 943   3              }
 944   2          }
 945   1      }
