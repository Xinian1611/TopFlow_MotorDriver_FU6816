 482          /* ==========================================================================
 483           *  八、状态帧组帧
 484           * --------------------------------------------------------------------------
 485           *  对应 20261030 CanSlave.c 的 ext_build_status()，字节定义见 CanProtocol.h：
 486           *      Byte0    ctrl：工作模式 + 启停 + 急停 回显
C51 COMPILER V9.60.7.0   CANMIN                                                            11/11/2026 10:23:48 PAGE 9   

 487           *      Byte1-2  实际转速（1rpm，32767=0，负=反转）
 488           *      Byte3-4  相电流（0.01A，32767=0）
 489           *      Byte5-6  功率（1W，32767=0）
 490           *      Byte7    故障码（0xFF=无故障）
 491           * ========================================================================== */
 492          static void CanMin_BuildStatus(uint8 *buf)
 493          {
 494   1          ExtStatusMsg_t *msg;
 495   1          int16 speed;
 496   1          int16 current;
 497   1          int16 power;
 498   1          uint8 ctrl;
 499   1      
 500   1          msg = (ExtStatusMsg_t *)buf;
 501   1          memset(msg, 0xFF, sizeof(ExtStatusMsg_t));
 502   1      
 503   1          /* ---- Byte0: ctrl 回显 ---- */
 504   1          ctrl = 0;
 505   1          EXT_SET_WORKMODE(ctrl, g_run_state.work_mode);
 506   1          EXT_SET_STARTSTOP(ctrl, (g_run_state.is_started != 0) ? EXT_STARTSTOP_START : EXT_STARTSTOP_STOP);
 507   1          EXT_SET_ESTOP(ctrl, (g_run_state.is_estop != 0) ? EXT_ESTOP_ACTIVE : EXT_ESTOP_RELEASE);
 508   1          msg->ctrl.value = ctrl;
 509   1      
 510   1          /* ---- Byte1-2: 实际转速 ---- */
 511   1          speed = (int16)CANMIN_S2F(mcFocCtrl.SpeedFlt);
 512   1          if (mcFocCtrl.FR == CCW)
 513   1          {
 514   2              speed = -speed;                         /* 协议：负值 = 反转 */
 515   2          }
 516   1          EXT_SET_I16(msg->speed_hi, msg->speed_lo, speed + 32767);
 517   1      
 518   1          /* ---- Byte3-4: 相电流（Q轴电流，0.01A） ---- */
 519   1          current = (int16)(CANMIN_I2F(FOC__IQ) * 100.0f);
 520   1          EXT_SET_I16(msg->current_hi, msg->current_lo, current + 32767);
 521   1      
 522   1          /* ---- Byte5-6: 功率（1W） ---- */
 523   1          power = mcFocCtrl.PowerFlt;
 524   1          EXT_SET_I16(msg->power_hi, msg->power_lo, power + 32767);
 525   1      
 526   1          /* ---- Byte7: 故障码 ----
 527   1           * 优先上报通信超时置的 g_run_state.fault_code（0x87 = 三级/通信异常停机）；
 528   1           * 其次是电机故障（mcFaultSource 非 0 时粗报 0x80）；
 529   1           * 都没有就是 0xFF。具体故障码可在 Keil 里看 mcFaultSource。 */
 530   1          if (g_run_state.fault_code != FAULT_NONE)
 531   1          {
 532   2              msg->fault_code = g_run_state.fault_code;
 533   2          }
 534   1          else if (mcFaultSource != FaultNoSource)
 535   1          {
 536   2              msg->fault_code = FAULT_BUILD(FAULT_LEVEL_3, 0);
 537   2          }
 538   1          else
 539   1          {
 540   2              msg->fault_code = FAULT_NONE;
 541   2          }
 542   1      }
