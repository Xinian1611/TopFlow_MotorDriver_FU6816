 846   3              }
 847   2      
 848   2              if (g_canmin_cmd_timeout >= CAN_CMD_TIMEOUT_MS)
 849   2              {
 850   3                  CanMin_SetRun(0);                                   /* 撤给定 + 停机 */
 851   3                  g_run_state.fault_code = FAULT_BUILD(FAULT_LEVEL_3, FAULT3_COMM_STOP);
 852   3              }
 853   2          }
 854   1          else
 855   1          {
 856   2              g_canmin_cmd_timeout = 0;
 857   2          }
