  38          /* 速度：Q15 -> rpm。
  39           * mcFocCtrl.SpeedFlt 是 Q15（32767 对应 MOTOR_SPEED_BASE = 4096rpm），
  40           * 除以 32767 再乘基准，就是实际转速。 */
  41          #define CANMIN_S2F(x)   ((float)(x) / 32767.0f * MOTOR_SPEED_BASE)
  42          
  43          /* 电流：Q15 -> A。
  44           * 电流采样链路的满量程 = HW_ADC_REF / (HW_RSHUNT * HW_AMPGAIN)，
  45           * 本板：4.5V / (0.001Ω * 16) = 281.25A（对应 32767）。 */
  46          #define CANMIN_I2F(x)   ((float)(x) / 32767.0f * (float)HW_ADC_REF / ((float)HW_RSHUNT * (float)HW_AMPGAIN
             -))
  47          
  48          /* 母线电压：Q15 -> V。满量程 = HW_BOARD_VOLT_MAX（由分压电阻决定）。 */
  49          #define CANMIN_U2F(x)   ((float)(x) / 32767.0f * (float)HW_BOARD_VOLT_MAX)
