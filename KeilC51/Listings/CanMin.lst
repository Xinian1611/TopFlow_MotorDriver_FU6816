 435   2              if (v >= 0)
 436   2              {
 437   3                  g_run_state.direction = FR_MODE;
 438   3              }
 439   2              else
 440   2              {
 441   3                  g_run_state.direction = (FR_MODE == CW) ? CCW : CW;
 442   3              }
 443   2              g_run_state.ref       = mag / 100.0f;
 444   2          }
 445   1          else
 446   1          {
 447   2              /* 转速模式：0.01% -> rpm */
 448   2              v   = (int32)speed - 32767;
 449   2              mag = (v >= 0) ? (float)v : (float)(-v);
 450   2              if (mag > 10000.0f)
 451   2              {
 452   3                  mag = 10000.0f;                     /* 钳到 ±100% */
 453   3              }
 454   2      
 455   2              /* 正数目标 = FR_MODE 方向；负数 = 反方向。
 456   2               * 20261030 的 Customer.h 是 FR_MODE=CW，所以它写死 CW/CCW；
 457   2               * 本工程对齐 20260923 后 FR_MODE=CCW，这里必须跟着 FR_MODE 走。 */
 458   2              if (v >= 0)
 459   2              {
 460   3                  g_run_state.direction = FR_MODE;
 461   3              }
 462   2              else
 463   2              {
 464   3                  g_run_state.direction = (FR_MODE == CW) ? CCW : CW;
 465   3              }
 466   2      
 467   2              if (mag <= 0.0f)
 468   2              {
 469   3                  g_run_state.ref = 0.0f;             /* 0% = 目标 0 */
 470   3              }
 471   2              else
 472   2              {
 473   3                  /* 非零指令：0.01%~100% 线性映射到 [CAN_MIN_RPM, CAN_PCT100_RPM]。
 474   3                   * CAN_MIN_RPM / CAN_PCT100_RPM 都来自 Customer.h 的
