 664   1      
 665   1          /* ---- 1. 运行状态清零（对应 MotorCtrl_Init()） ---- */
 666   1          g_run_state.work_mode        = EXT_WORK_MODE_SPEED;
 667   1          g_run_state.is_started       = 0;           /* 上电不自动起机，等 CAN 的“起机” */
