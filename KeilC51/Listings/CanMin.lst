 801   1          uint8 n;
 802   1      
 803   1          /* ---- ① 收帧：NOEMP=1 表示接收 FIFO 非空 ---- */
 804   1          for (n = 0; n < CAN_RX_PER_TICK; n++)
 805   1          {
 806   2              if (!ReadBit(CAN_SR, NOEMP))
 807   2              {
 808   3                  break;
 809   3              }
 810   2      
 811   2              CanMin_ReadFrame();                     /* 读出最老的一帧到 CanMin */
 812   2              SetBit(CAN_CR1, BUFRLS);                /* 释放该接收缓冲 */
 813   2              ClrBit(CAN_IFR, RXIF);                  /* 清接收标志（无中断，清一下更干净） */
 814   2      
 815   2              g_canmin_stat.RxFrames++;
 816   2              g_canmin_stat.LastId = CanMin.EXTID;    /* 调试：最近一帧 ID */
 817   2      
 818   2              /* IAP 帧：29 位扩展帧，ID<=0x7FF（高 21 位为 0） */
 819   2              if ((CanMin.CAN_IDE == IDE_EXT) && ((CanMin.EXTID & 0xFFFFF800UL) == 0))
 820   2              {
 821   3                  IAPRxStdFrame((uint16)(CanMin.EXTID & 0x07FF), &CanMin.Data0, CanMin.CAN_DLC);
 822   3              }
 823   2              else
 824   2              {
 825   3                  CanMin_MsgParse();                  /* 地址过滤 + 解析指令 */
 826   3              }
 827   2          }
 828   1      
 829   1          /* ---- ② 统计 ---- */
 830   1          if (ReadBit(CAN_SR, BUFOV))
 831   1          {
 832   2              g_canmin_stat.RxOvif++;                 /* 接收 FIFO 溢出 */
 833   2          }
 834   1      
 835   1          /* ---- ② bus-off：边沿触发立即恢复，之后每 10ms 重试 ----
 836   1           * 检测每 1ms 做一次（只读一个 SFR，开销可忽略）；
 837   1           * 恢复不能每个 1ms 都做：翻 RSTMOD 会清接收 FIFO、打断控制器同步。 */
 838   1          if (ReadBit(CAN_ESR, BOFF))
 839   1          {
 840   2              if (!g_canmin_busoff_seen)
 841   2              {
 842   3                  g_canmin_busoff_seen = 1;
