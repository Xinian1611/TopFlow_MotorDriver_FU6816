 613          /* ==========================================================================
 614           *  十、按 ID + 数据发送一帧（对应 20261030 的 can_hw_send()）
 615           * --------------------------------------------------------------------------
 616           *  @param can_id 29 位扩展 ID（>0x7FF 自动用扩展帧）
 617           *  @param dat    8 字节数据
 618           *  @param len    必须是 8
 619           *  @retval 1=已提交发送，0=上一帧没发完/参数错
 620           * ========================================================================== */
 621          static uint8 CanMin_HwSend(uint32 can_id, uint8 *dat, uint8 len)
 622          {
 623   1          if ((len != CAN_FRAME_DATA_LEN) || (dat == 0))
 624   1          {
 625   2              return 0;
 626   2          }
 627   1      
 628   1          if (can_id > 0x7FFUL)
 629   1          {
 630   2              CanMinSend.CAN_IDE = IDE_EXT;           /* 扩展帧 */
 631   2          }
 632   1          else
 633   1          {
 634   2              CanMinSend.CAN_IDE = IDE_STD;           /* 标准帧 */
 635   2          }
 636   1      
 637   1          CanMinSend.CAN_RTR = RTR_DAT;               /* 数据帧 */
 638   1          CanMinSend.CAN_DLC = len;
 639   1          CanMinSend.EXTID   = can_id;
 640   1          CanMinSend.STDID   = can_id;
 641   1      
 642   1          CanMinSend.Data0 = dat[0];
 643   1          CanMinSend.Data1 = dat[1];
 644   1          CanMinSend.Data2 = dat[2];
 645   1          CanMinSend.Data3 = dat[3];
 646   1          CanMinSend.Data4 = dat[4];
 647   1          CanMinSend.Data5 = dat[5];
 648   1          CanMinSend.Data6 = dat[6];
 649   1          CanMinSend.Data7 = dat[7];
 650   1      
 651   1          return CanMin_Send();
 652   1      }
