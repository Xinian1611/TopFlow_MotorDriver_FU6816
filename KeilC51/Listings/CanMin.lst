 777   1          for (i = 0; i < 10; i++)
 778   1          {
 779   2              _nop_();                                /* 等复位请求生效（约 0.4us @24MHz） */
 780   2          }
 781   1          ClrBit(CAN_CR0, RSTMOD);                    /* 回正常模式 */
 782   1      
