 293   1          cur_raw   = EXT_GET_U16(msg->target_current_hi, msg->target_current_lo);
 294   1      
 295   1          g_canmin_stat.RxCmdOk++;
 296   1      
 297   1      #if (CAN_CMD_TIMEOUT_MS > 0)
