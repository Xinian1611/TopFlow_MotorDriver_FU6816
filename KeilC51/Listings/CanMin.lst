 436   2              if (v >= 0)
 437   2              {
 438   3                  g_run_state.direction = FR_MODE;
 439   3              }
 440   2              else
 441   2              {
 442   3                  g_run_state.direction = (FR_MODE == CW) ? CCW : CW;
 443   3              }
 444   2              g_run_state.ref       = mag / 100.0f;
 445   2          }
 446   1          else
 447   1          {
 448   2              /* 转速模式：0.01% -> rpm */
 449   2              v   = (int32)speed - 32767;
 450   2              mag = (v >= 0) ? (float)v : (float)(-v);
 451   2              if (mag > 10000.0f)
 452   2              {
 453   3                  mag = 10000.0f;                     /* 钳到 ±100% */
 454   3              }
 455   2      
 456   2              /* 正数目标 = FR_MODE 方向；负数 = 反方向。
 457   2               * 20261030 的 Customer.h 是 FR_MODE=CW，所以它写死 CW/CCW；
 458   2               * 本工程对齐 20260923 后 FR_MODE=CCW，这里必须跟着 FR_MODE 走。 */
 459   2              if (v >= 0)
 460   2              {
 461   3                  g_run_state.direction = FR_MODE;
 462   3              }
 463   2              else
 464   2              {
 465   3                  g_run_state.direction = (FR_MODE == CW) ? CCW : CW;
 466   3              }
 467   2      
 468   2              if (mag <= 0.0f)
 469   2              {
 470   3                  g_run_state.ref = 0.0f;             /* 0% = 目标 0 */
 471   3              }
 472   2              else
 473   2              {
 474   3                  /* 非零指令：0.01%~100% 线性映射到 [CAN_MIN_RPM, CAN_PCT100_RPM]。
 475   3                   * CAN_MIN_RPM / CAN_PCT100_RPM 都来自 Customer.h 的
 476   3                   * MOTOR_SPEED_MIN_RPM / MOTOR_SPEED_MAX_RPM，
