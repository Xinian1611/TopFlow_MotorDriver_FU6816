  32          void CMP3_Init(void)
  33          {
  34   1         
  35   1          /******CMP3 端口模拟功能设置*******/    
  36   1          #if (Shunt_Resistor_Mode == Single_Resistor)
  37   1          {
  38   2              SetBit(P2_AN , P27);          //CMP3 Pin设置为模拟模式  + 
  39   2              ClrBit(CMP_CR1 , CMP3MOD1);     //00-->P27-单比较器模式    01-->P20/P23-双比较器模式
  40   2              ClrBit(CMP_CR1 , CMP3MOD0);     //1X-->P20/P23/P27-三比较器模式
  41   2          }
  42   1          #elif (Shunt_Resistor_Mode == Double_Resistor)
                  {
                      SetBit(P2_AN , P27);          //CMP3 Pin设置为模拟模式  + 
                      ClrBit(CMP_CR1 , CMP3MOD1);     //00-->P27-单比较器模式    01-->P20/P23-双比较器模式
                      ClrBit(CMP_CR1 , CMP3MOD0);     //1X-->P20/P23/P27-三比较器模式
                  }
                  #elif (Shunt_Resistor_Mode == Three_Resistor)
                  {
                      SetBit(P2_AN , P27 | P23 | P20);// CMP3 Pin设置为模拟模式  + 
                      SetBit(CMP_CR1 , CMP3MOD1);     // 00-->P27-单比较器模式    01-->P20/P23-双比较器模式
                      SetBit(CMP_CR1 , CMP3MOD0);     // 1X-->P20/P23/P27-三比较器模式
                  }
C51 COMPILER V9.60.7.0   CMP                                                               10/20/2026 17:28:32 PAGE 2   

                  #endif  //end Shunt_Resistor_Mode
  55   1          
  56   1          #if (COMPARE_MODE == COMPARE_HW_MODE)
                  {
                      /**P2.6使能其模拟功能，使能数字输出**/
                      SetBit(P2_AN , P26);
                      ClrBit(P2_OE , P26); 
                      ClrBit(DAC_CR , DAC0_1EN);
                  }
                  #else
  64   1          {
  65   2      //        /**P2.6使能其模拟功能，使能数字输出**/
  66   2      //        SetBit(P2_AN , P26);
  67   2      //        SetBit(P2_OE , P26); 
  68   2              /* DAC0 Enable */
  69   2              SetBit(DAC_CR , DAC0_1EN);        
  70   2              /******************************
  71   2              0: 正常模式，DAC输出电压范围为0到VREF
  72   2              1: 半电压转换模式，DAC输出电压范围为VHALF到VREF
  73   2              ****************************/
  74   2              ClrBit(DAC_CR , DACMOD);
  75   2              /**********设置DAC过流值,舍弃低位精度*****************/
  76   2              
  77   2              //  DAC0_DR 是DAC0的高8位,DAC0 的最低位忽略
  78   2              DAC0_DR     =   DAC_OverCurrentValue;
  79   2          }
  80   1          #endif  //end Compare_Mode
  81   1          
  82   1          SetBit(CMP_CR1 , CMP3HYS);  // CMP3 Hysteresis voltage Enable
  83   1          /*---------------------------------------------------------------------------------
  84   1        选择母线电流保护触发信号源，外部中断0或者比较器3中断。
  85   1        0-CMP3,1-INT0
  86   1          ---------------------------------------------------------------------------------*/
  87   1          ClrBit(EVT_FILT, INT0_MOE_EN);
  88   1          
  89   1          
  90   1          /*---------------------------------------------------------------------------------
  91   1        触发硬件保护后硬件关闭驱动输出MOE配置， 常规应用需要使能MOE自动清零
  92   1        00--MOE不自动清零
  93   1        01--MOE自动清零
  94   1          ----------------------------------------------------------------------------------*/
  95   1          ClrBit(EVT_FILT , MOEMD1);
  96   1          SetBit(EVT_FILT , MOEMD0);
  97   1          /*----------------------------------------------------------------------------------
  98   1          
  99   1          
 100   1          母线电流保护时间滤波宽度
 101   1          00-不滤波    
 102   1          01-4cpu clock    
 103   1          10-8cpu clock    
 104   1          11-16cpu clock
 105   1          -----------------------------------------------------------------------------------*/
 106   1          SetBit(EVT_FILT , EFDIV1);
 107   1          SetBit(EVT_FILT , EFDIV0);
 108   1      
 109   1          SetBit(CMP_CR1 , CMP3EN);   //CMP3 Enable
 110   1      #if (HWOC_PROTECT_EN == 0)
                  ClrBit(CMP_CR0, CMP3IM1);
                  ClrBit(CMP_CR0, CMP3IM0);      /* 00 = 不产生中断 */
              #else
 114   1          ClrBit(CMP_CR0, CMP3IM1);
 115   1          SetBit(CMP_CR0, CMP3IM0);
