 134          void CMP3_Interrupt_Init(void)
 135          {
 136   1          ClrBit(CMP_SR , CMP3IF);
 137   1          /*------------------------------------------------------------------------
 138   1          比较器中断模式配置
 139   1          00: 不产生中断  
 140   1          01: 上升沿产生中断  
 141   1          10: 下降沿产生中断  
 142   1          11: 上升/下降沿产生中断
 143   1          ------------------------------------------------------------------------*/
 144   1          ClrBit(CMP_CR0 , CMP3IM1);
 145   1          SetBit(CMP_CR0 , CMP3IM0);
 146   1          
 147   1          SetBit(IP3 , PCMP31);    // 中断优先级别3
 148   1          SetBit(IP3 , PCMP30);
 149   1              
 150   1      }
