 584          /* ==================== 【调试用】协议层状态打印 ====================
 585           * 由 main.c 大循环每 500ms 调一次。printf 阻塞，禁止放进中断 / 1ms 任务。
 586           * 硬件/寄存器层的计数见 CAN.c 的 CAN_DebugPrint()。
 587           *
 588           * 与 CAN_DebugPrint() 配合分诊（从头往后看，哪一步断了就是哪一层的问题）：
 589           *   [CAN] rx 涨  → 硬件收到了帧
 590           *   [CAN] pop 涨 → 1ms 任务把它从环形缓冲取出来了
 591           *   [CAN-S] in 涨      → 帧进了协议层
 592           *   [CAN-S] cmd 涨     → 被当成指令报文处理了（CAN 链路到此为止全程正常）
 593           *   cmd 涨但电机不动   → 问题在指令解析 / 控制层，跟 CAN 无关
 594           */
 595          void ext_slave_debug_print(void)
 596          {
 597   1          /* --- 接收 ------------------------------------------------------------------------
 598   1           * in   = g_dbg_rxTotal    : 进入 ext_slave_process_rx() 的帧数
 599   1           *                           （= CAN_MsgParse 出队、且 CAN_IDE 判定为扩展帧）
 600   1           *                           正常：跟 [CAN] pop 同步涨
 601   1           *                           若 [CAN] pop 在涨而 in 不涨 => CAN_MsgParse 里 IDE 判断没进
 602   1           *                           （收到的帧被当成标准帧丢了），去看 [CAN] 那行的 ide �
             -��段
 603   1           * bad  = g_dbg_rxBad      : len!=8 或 dat==NULL 被丢弃的帧数
 604   1           *                           正常 0；不为 0 说明主机发的 DLC 不是 8
 605   1           * filt = g_dbg_rxFiltered : 被地址过滤丢掉的帧数，两种情况都会算进来：
 606   1           *                             ① 主类别/副类别与本机不符，或 设备号既不是本机�
C51 COMPILER V9.60.7.0   CANSLAVE                                                          10/20/2026 17:28:30 PAGE 11  

             -�不是 0(广播)
 607   1           *                             ② msg_num == 0（非法帧号）
 608   1           *                           正常 0；涨而 cmd 不涨 => 主机的 ID 和本机地址对不上，
 609   1           *                           本机地址在 main.c 的 ext_cfg：sys=0 / 主类别=11 / 副类别=15 
             -/ 设备号=1
 610   1           *                           （设备号填 0 表示广播，也会被接收）
 611   1           * cmd  = g_dbg_rxCmd      : 判定为指令报文(pri=2)并进入 ext_process_cmd_message() 的帧数
 612   1           *                           正常：跟 in 同步涨
 613   1           *                           ★注意：这里只统计"进入了指令处理函数"，
 614   1           *                             并不保证没被里面的调试钩子(db g_cmd)吞掉
 615   1           * -------------------------------------------------------------------------------------- */
 616   1          printf("[CAN-S] in=%u bad=%u filt=%u cmd=%u\r\n",
 617   1                 g_dbg_rxTotal, g_dbg_rxBad, g_dbg_rxFiltered, g_dbg_rxCmd);
