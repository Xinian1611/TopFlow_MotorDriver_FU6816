 467   4              LS.SData3D[2] = 0x7F; //  RSID
 468   4              LS.SData3D[3] = 0xB2; //  requested SID
 469   4              LS.SData3D[4] = 0x12; //  error code
 470   4              LS.SData3D[5] = 0xFF;
 471   4              LS.SData3D[6] = 0xFF;
 472   4              LS.SData3D[7] = 0xFF;
