 488   3            LS.SData3D[2] = 0xF6; //  RSID = SID+0x40
 489   3            LS.SData3D[3] = 0xFF; //  unused
 490   3            LS.SData3D[4] = 0xFF; //  unused
 491   3            LS.SData3D[5] = 0xFF; //  unused
 492   3            LS.SData3D[6] = 0xFF; //  unused
 493   3            LS.SData3D[7] = 0xFF; //  unused
 494   3            LS.Pack = 1;
