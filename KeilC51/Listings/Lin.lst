  54          void LIN_Init(void)
  55          {
  56   1        /*-------------------------------------------------------------------------------------------------
  57   1          DMA通道配置
  58   1          DMASEL=1:配置为DMA1 DMASEL=0:配置为DMA0
  59   1        -------------------------------------------------------------------------------------------------*/
  60   1        /* 初始化寄存器,关闭LIN模块 */
  61   1        DMA0_CR0 = 0;
  62   1        LIN_CR = 0;
  63   1        LIN_SR = 0;
  64   1        LIN_CSR = 0;
  65   1        /* 配置dma通道 */
  66   1        DMA0_BA = (uint16)ucaLinBuff;
  67   1        SetBit(DMA0_CR0, DMAEN | DMACFG2 | DMACFG1);
  68   1        ClrBit(LIN_CR, DMASEL);
  69   1        /* 配置LIN接口 */
  70   1        
  71   1        #if (LIN_TRANSCEIVER == EXTERNAL_LIN_DOUBLELINE)//双线模式 
                      #if (LIN_PORTSELECTION == TXDGP10_RXDGP11)
                      SetBit(LIN_CR, CHSEL1);   // 00:配置为TXD：P00 RXD：p01;
                      ClrBit(LIN_CR, CHSEL0);   // 10:配置为TXD：P10 RXD：p11    //11:单线lin P11
                      ClrBit(P1_PU, P11HV_EN);  // P11 高压输入模式，关闭   P11与P10口为开漏输出，需�
             -�加硬件上拉
                      ClrBit(P1_PU, P10HV_EN);  // P10 高压输入模式，关闭
                      #elif (LIN_PORTSELECTION == TXDGP00_RXDGP01)
                      ClrBit(LIN_CR, CHSEL1);   // 00:配置为TXD：P00 RXD：p01;
                      ClrBit(LIN_CR, CHSEL0);   // 10:配置为TXD：P10 RXD：p11    //11:单线lin P11    
                      SetBit(P0_PU , P01);      // RXD注意是否有硬件上拉，可以配置软件上拉
                      #endif
                      SetBit(P4_OE, P43);
                      GP43 = 1;               /* 外置收发器休眠管脚使能配置 */
                #elif (LIN_TRANSCEIVER == INNER_LIN_SINGLELINE)//单线模式P11
  85   1              SetBit(LIN_CR, CHSEL1);   // 00:配置为TXD：P00 RXD：p01;
  86   1              SetBit(LIN_CR, CHSEL0);   // 10:配置为TXD：P10 RXD：p11    //11:单线lin P11
  87   1              SetBit(P1_PU, P11HV_EN);  // P11 高压输入模式，关闭   P11与P10口为开漏输出，需�
             -�加硬件上拉
  88   1        #endif
  89   1        
  90   1        ClrBit(LIN_CR, CHKMOD);   // 0:增强校验    1:标准校验
  91   1        ClrBit(LIN_CR, AUTOSIZE); // 自动长度设定（ID[4][5]决定）
  92   1        SetBit(LIN_CR, LINIE);    // 中断设置
  93   1        SetBit(LIN_CSR, LINEN);   // LIN模块使能
  94   1      
  95   1        SetBit(LIN_CR, MBAUD);    // 手动波特率
  96   1        LIN_BAUD = 1249;          // 波特率为19200
  97   1      }
