 119          /* -------------------------------------------------------------------------------------------------
 120            Function Name  : LIN_Error_LenthHanding
 121            Description    : 处理长度错误的函数
 122            Date           : 2020-07-30
 123            Parameter      : LIN一致性的Response err 要求在接收到完整正确的帧头之后发生错误，
             -错误标志位才能置1
 124          ------------------------------------------------------------------------------------------------- */
 125          void LIN_Error_LenthHanding(void)
 126          {
 127   1          if (ID_Rflag == ID_RX) /* 判断上一次的接收数据有没有完成 */
 128   1          {
 129   2              if ((Drlen != 0) && (Drlen < 8)) /* 前一帧数据长度不满足要求 */
 130   2              {
 131   3                  Lin_Response_ER = 1; /* 故障标志位置1 */
 132   3              }
 133   2          }
 134   1          if (Lin_Response_ER)    /* 发送故障标志位 */
 135   1          {
 136   2          //      ucaLinBuff[0] = 0x01; /* 发送故障标志位  */
 137   2              EOP.ECF_LinLostError = 1; /* 发送故障标志位  */
 138   2              EOP.ECF_FaultSt      = 1;
 139   2          }
 140   1          else
 141   1          {
 142   2          //      ucaLinBuff[0] = 0x00;
 143   2              EOP.ECF_LinLostError = 0; /* 发送故障标志位  */
 144   2              EOP.ECF_FaultSt      = 0;
 145   2              
 146   2          }
 147   1          Lin_Response_ER = 0; /* 发送完成之后清除故障标志位 */
 148   1      }
 149          /* -------------------------------------------------------------------------------------------------
 150            Function Name  : LIN_Error_Handing
 151            Description    : 处理错误的函数
 152            Date           : 2020-07-30
 153            Parameter      : LIN一致性的Response err 要求在接收到完整正确的帧头之后发生错误，
