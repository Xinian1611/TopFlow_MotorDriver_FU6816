 506   3            LS.SData3D[0] = LS.NAD;
 507   3            LS.SData3D[1] = 1;    //  PCI
 508   3            LS.SData3D[2] = 0xF7; //  RSID = SID+0x40
 509   3            LS.SData3D[3] = 0xFF; //  unused
 510   3            LS.SData3D[4] = 0xFF; //  unused
 511   3            LS.SData3D[5] = 0xFF; //  unused
 512   3            LS.SData3D[6] = 0xFF; //  unused
 513   3            LS.SData3D[7] = 0xFF; //  unused
 514   3            LS.Pack = 1;
 515   3            /*        ID:0x20       */
 516   3            if (LS.RData[4] != 0XFF)
 517   3              l_PID_Table[tmp] = LS.RData[4];
 518   3            if (LS.RData[5] != 0XFF)
 519   3              l_PID_Table[tmp + 1] = LS.RData[5];
 520   3            if (LS.RData[6] != 0XFF)
