 165   2          {
 166   3            Lin_Response_ER = 1; // lin总线错误
 167   3          }
 168   2        }
 169   1        else if (ID_Error_BIT()) // bit数据错误
 170   1        {
 171   2          ClrBit(LIN_CSR, ERRBIT);
 172   2      //    ClrBit(LIN_CSR, LINSTOP);  //自动波特率时候要做清除操作
 173   2          if (ID_Rflag)      // 总线的数据是发送或者接收时候
C51 COMPILER V9.60.7.0   LIN                                                               09/21/2026 17:11:32 PAGE 4   

 174   2            Lin_Response_ER = 1; // lin总线错误
 175   2        }
 176   1      
 177   1      }
