 659          /**
 660           * @brief        控制给定爬坡函数
 661           *               以浮点进行计算，解决整数爬坡由于精度的影响，导致爬坡结果阶�
             -�变化
 662           *               函数控制周期默认为闭环控制周期，建议使用默认1ms周期运行
 663           * @param[in]    ref 给定目标值
 664           * @return       爬坡结果（int16）
 665           * @date         2022-07-14
 666           */
 667          int16 Motor_Ramp(int16 ref)
 668          {
 669   1          mcRefRamp.RefValue = ref; // 爬坡函数输入
 670   1      
 671   1          if (mcRefRamp.OutValue_float < mcRefRamp.RefValue)
 672   1          {
 673   2              if (mcRefRamp.OutValue_float + mcRefRamp.IncValue < mcRefRamp.RefValue)
 674   2              {
 675   3                  mcRefRamp.OutValue_float += mcRefRamp.IncValue;
 676   3              }
 677   2              else
 678   2              {
 679   3                  mcRefRamp.OutValue_float = mcRefRamp.RefValue;
 680   3              }
 681   2          }
 682   1          else
 683   1          {
 684   2              if (mcRefRamp.OutValue_float - mcRefRamp.DecValue > mcRefRamp.RefValue)
 685   2              {
 686   3                  mcRefRamp.OutValue_float -= mcRefRamp.DecValue;
 687   3              }
 688   2              else
 689   2              {
 690   3                  mcRefRamp.OutValue_float = mcRefRamp.RefValue;
 691   3              }
 692   2          }
 693   1      
 694   1          return (int16)mcRefRamp.OutValue_float; // 输出浮点数取整
 695   1      }
