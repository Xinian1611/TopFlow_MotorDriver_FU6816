 497   1          {
 498   2              if (mcRefRamp.OutValue_float + mcRefRamp.IncValue < mcRefRamp.RefValue)
 499   2              {
 500   3                  mcRefRamp.OutValue_float += mcRefRamp.IncValue;
 501   3              }
