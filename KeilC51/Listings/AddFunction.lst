  89   3                  {
  90   4                      mcPwmInput.MotorOffFilter = MotorOffFilterTime;
  91   4                      if (mcPwmInput.MotorOnFilter == 0) // 开机滤波
  92   4                      {
  93   5                          mcPwmInput.MotorOnFilter = MotorOnFilterTime;
  94   5                          isCtrlPowOn = true; // 开机
  95   5                      }
  96   4                  }
  97   3                  else if ((dutyTemp < OFFPWMDuty) || (dutyTemp > OFFPWMDutyHigh))
  98   3                  {
  99   4                      mcPwmInput.MotorOnFilter = MotorOnFilterTime;
