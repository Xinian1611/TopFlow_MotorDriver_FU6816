                          }
                          else if (g_run_state.work_mode == EXT_WORK_MODE_CURRENT)
                          {
                              mcFocCtrl.Ref = I_Value(g_run_state.ref);
                          }
              #if (MOTOR_POSITION_CLOSE_LOOP != 0)
                          else if (g_run_state.work_mode == EXT_WORK_MODE_POSITION)
                          {
