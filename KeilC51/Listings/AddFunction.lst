 496   1          mcRefRamp.RefValue = ref; // 爬坡函数输入
 497   1      
 498   1          if (mcRefRamp.OutValue_float < mcRefRamp.RefValue)
 499   1          {
 500   2              if (mcRefRamp.OutValue_float + mcRefRamp.IncValue < mcRefRamp.RefValue)
 501   2              {
 502   3                  mcRefRamp.OutValue_float += mcRefRamp.IncValue;
 503   3              }
 504   2              else
 505   2              {
 506   3                  mcRefRamp.OutValue_float = mcRefRamp.RefValue;
 507   3              }
 508   2          }
 509   1          else
 510   1          {
 511   2              if (mcRefRamp.OutValue_float - mcRefRamp.DecValue > mcRefRamp.RefValue)
 512   2              {
 513   3                  mcRefRamp.OutValue_float -= mcRefRamp.DecValue;
 514   3              }
 515   2              else
 516   2              {
 517   3                  mcRefRamp.OutValue_float = mcRefRamp.RefValue;
 518   3              }
 519   2          }
 520   1      
 521   1          return (int16)mcRefRamp.OutValue_float; // 输出浮点数取整
 522   1      }
