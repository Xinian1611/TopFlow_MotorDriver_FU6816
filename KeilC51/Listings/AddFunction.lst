  68          /**
  69           * @brief        PWM调速信号计算，本例程提供Duty计算，如需频率信号可自行使用mcPw
             -mInput.Period周期值计算
  70           * @date         2022-07-14
  71           */
  72          void PWMDutyCal(void)
  73          {
  74   1          static uint16 dutyTemp = 0;
  75   1      
  76   1          if (mcPwmInput.isUpdate) // 有新的duty更新
  77   1          {
  78   2              if ((Abs_F32(mcPwmInput.TimerDR - mcPwmInput.TimerDROld) < 0xFF)       // 误差在1个Byte之间�
             -��处理
  79   2                  && (Abs_F32(mcPwmInput.TimerARROld - mcPwmInput.TimerARR) < 0xFF)) // 误差在1个Byte之间�
             -��处理
  80   2              {
  81   3                  mcPwmInput.Compare = mcPwmInput.TimerDR; // 读取DR与ARR值
  82   3                  mcPwmInput.Period = mcPwmInput.TimerARR;
  83   3                  mcPwmInput.Duty = MDU_DIV0_GetQL16(mcPwmInput.Compare >> 1, 0x0000, mcPwmInput.Period);
  84   3      /***速度随PWM增大而增大***/
  85   3      #if (PWMDUTY_POLARITY == NegaPWMDUTY)
                          {
                              dutyTemp = 32768 - mcPwmInput.Duty;
                          }
              /***速度随PWM增大而减小***/
              #else
  91   3                  {
  92   4                      dutyTemp = mcPwmInput.Duty;
  93   4                  }
  94   3      #endif
  95   3      
  96   3                  if ((dutyTemp > ONPWMDuty) && (dutyTemp <= OFFPWMDutyHigh))
  97   3                  {
  98   4                      mcPwmInput.MotorOffFilter = MotorOffFilterTime;
  99   4                      if (mcPwmInput.MotorOnFilter == 0) // 开机滤波
 100   4                      {
 101   5                          mcPwmInput.MotorOnFilter = MotorOnFilterTime;
 102   5                          isCtrlPowOn = true; // 开机
 103   5                      }
 104   4                  }
 105   3                  else if ((dutyTemp < OFFPWMDuty) || (dutyTemp > OFFPWMDutyHigh))
 106   3                  {
 107   4                      mcPwmInput.MotorOnFilter = MotorOnFilterTime;
 108   4                      if (mcPwmInput.MotorOffFilter == 0) // 关机滤波
 109   4                      {
