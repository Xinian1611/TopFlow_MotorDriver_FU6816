  63           */
  64          void PWMDutyCal(void)
  65          {
  66   1          static uint16 dutyTemp = 0;
  67   1      
  68   1          if (mcPwmInput.isUpdate) // 有新的duty更新
  69   1          {
  70   2              if ((Abs_F32(mcPwmInput.TimerDR - mcPwmInput.TimerDROld) < 0xFF)       // 误差在1个Byte之间�
             -��处理
  71   2                  && (Abs_F32(mcPwmInput.TimerARROld - mcPwmInput.TimerARR) < 0xFF)) // 误差在1个Byte之间�
             -��处理
  72   2              {
  73   3                  mcPwmInput.Compare = mcPwmInput.TimerDR; // 读取DR与ARR值
  74   3                  mcPwmInput.Period = mcPwmInput.TimerARR;
  75   3                  mcPwmInput.Duty = MDU_DIV0_GetQL16(mcPwmInput.Compare >> 1, 0x0000, mcPwmInput.Period);
  76   3      /***速度随PWM增大而增大***/
  77   3      #if (PWMDUTY_POLARITY == NegaPWMDUTY)
                          {
                              dutyTemp = 32768 - mcPwmInput.Duty;
                          }
              /***速度随PWM增大而减小***/
              #else
  83   3                  {
  84   4                      dutyTemp = mcPwmInput.Duty;
  85   4                  }
  86   3      #endif
  87   3      
