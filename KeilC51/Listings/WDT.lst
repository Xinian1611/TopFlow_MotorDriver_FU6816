   9           #include "FU68xx_6_MCU.h"
  10           #include "WDT_INIT.h"
  11           
  12           /**
  13           * @function     WatchDogConfig
  14           * @brief        看门狗初始化
  15           * @param[in]    Value:[输入]----定时时间，单位ms，最小定时时间8ms，最大定时时间1800ms
  16           * @return       None
  17           * @date         2023-06-27
  18          */
  19          void WatchDogConfig(unsigned int Value)
  20          {
  21   1        SetBit(CCFG1, WDT_EN);          //看门狗使能
  22   1        WDT_ARR = ((unsigned int)(65532 - (unsigned long int)Value * 32768 / 1000) >> 8);
  23   1        RST_SR = 0x80;
  24   1      //  ClrBit(RST_SR, RSTWDT);         //看门狗复位标志清零
  25   1        SetBit(WDT_CR, WDTRF);          //看门狗初始化
  26   1      }
  27          
  28           /**
  29           * @function     WatchDogRefresh
  30           * @brief        看门狗喂狗
  31           * @param[in]    None
  32           * @return       None
  33           * @date         2023-06-27
  34          */
  35          void WatchDogRefresh(void)
  36          {
  37   1        SetBit(WDT_CR, WDTRF);        //看门狗复位标志位
  38   1      }


