 138   2          }
 139   1          else if (out < -g_pos_speed_limit)           /* 反向超限 */
 140   1          {
 141   2              out = -g_pos_speed_limit;                /* 反向限幅 */
 142   2          }
 143   1      
 144   1          if ((out > 0.0f) && (out < POS_SPEED_MIN_RPM)) /* 正向小于最小速度 */
 145   1          {
 146   2              out = POS_SPEED_MIN_RPM;                 /* 抬到最小速度 */
 147   2          }
 148   1          if ((out < 0.0f) && (out > -POS_SPEED_MIN_RPM)) /* 反向小于最小速度 */
 149   1          {
 150   2              out = -POS_SPEED_MIN_RPM;                /* 抬到最小速度 */
 151   2          }
 152   1      
 153   1          s_pos.speedCmd = out;                        /* 保存输出，供观测 */
 154   1          g_run_state.direction  = (out >= 0.0f) ? CW : CCW; /* 符号 -> 方向 */
 155   1          g_run_state.ref        = POS_ABS_F(out);     /* 幅值 -> 速度给定 */
 156   1          g_run_state.is_started = 1;                  /* 允许运行 */
 157   1          s_pos.state            = POS_MOVING;         /* 标记正在调节 */
 158   1          return 0;                                    /* 已输出速度给定 */
 159   1      }
