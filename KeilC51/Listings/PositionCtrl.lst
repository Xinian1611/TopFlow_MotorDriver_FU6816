  98           * @note   只算位置环；限位、堵转、故障不在这里处理。
  99           */
 100          uint8 PositionCtrl_PID(void)                     /* 位置 PI 计算 */
 101          {
 102   1          float out;                                   /* PI 输出，单位 rpm */
 103   1          s_pos.err = s_pos.target - s_pos.fb;         /* 计算误差：目标 - 反馈 */
 104   1      
 105   1          if (POS_ABS_F(s_pos.err) <= POS_DEADBAND)    /* 误差进入到位死区 */
 106   1          {
