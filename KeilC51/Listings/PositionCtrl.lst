  60           */
  61          uint8 PositionCtrl_Current(void)                 /* 读 MT6701 当前位置 */
  62          {
  63   1          float raw;                                   /* 原始单圈角度，单位 ° */
  64   1          float rawFb;                                 /* 反馈 raw 临时值*/
  65   1          //均值还没完成、电压高于上限：越界、电压低于下限：断线/越界
  66   1          if (((g_mt6701_anaSt & 0x01) == 0) || (g_mt6701_mv < POS_FB_MV_MIN) || (g_mt6701_mv > POS_FB_MV_MAX))
  67   1          {
