 122   3                  s_pos.integ = POS_I_LIMIT;           /* 限幅 */
 123   3              }
 124   2              else if (s_pos.integ < -POS_I_LIMIT)     /* 积分下限 */
 125   2              {
 126   3                  s_pos.integ = -POS_I_LIMIT;          /* 限幅 */
 127   3              }
 128   2          }
 129   1          else                                         /* 误差大，不用积分 */
 130   1          {
 131   2              s_pos.integ = 0.0f;                      /* 清积分，防饱和 */
 132   2          }
 133   1          out += s_pos.integ;                          /* P + I */
 134   1      
 135   1          if (out > g_pos_speed_limit)                 /* 正向超限：由 CmdPosition 的 speed 字段决定 
             -*/
 136   1          {
