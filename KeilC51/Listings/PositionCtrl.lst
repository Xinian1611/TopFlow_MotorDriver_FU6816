 111   2              g_run_state.is_started = 0;              /* 请求 mcStop，由 MC_Stop 减速/抱闸 */
 112   2              return 1;                                /* 本周期不输出 */
 113   2          }
 114   1      
 115   1          s_pos.inposCnt = 0;                          /* 误差出了死区，清到位计数 */
 116   1          out = POS_KP * s_pos.err;                    /* 比例项 */
 117   1          if (POS_ABS_F(s_pos.err) <= POS_I_ZONE)      /* 误差在积分区 */
 118   1          {
