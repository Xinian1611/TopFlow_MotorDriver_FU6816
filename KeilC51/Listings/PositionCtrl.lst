                      (g_run_state.is_started != 0) &&
                      (g_run_state.ref > 0.0f) &&
                      (g_run_state.direction == CW))
                  {
                      s_speedLimitLatch = 1;
                      return POS_PROTECT_LIMIT;
                  }
              
                  if ((s_pos.fb <= POS_LIMIT_MIN) &&
                      (g_run_state.is_started != 0) &&
