  69   2              g_pos_fb_raw  = 0xFFFF;                  /* 状态报文反馈无效 */
  70   2              return 0;                                /* 返回无效 */
  71   2          }
  72   1          raw = (float)MT6701_GetAngle10() / 10.0f;    /* 0.1° -> 0° */
  73   1      
  74   1          if (s_pos.fbValid == 0)                      /* 第一次有效反馈 */
  75   1          {
  76   2              s_pos.fbFilt  = raw;                     /* 用当前值填种，避免从 0 拉起 */
  77   2              s_pos.fbValid = 1;                       /* 标记反馈有效 */
  78   2          }
  79   1          else                                         /* 后续反馈 */
  80   1          {
  81   2              s_pos.fbFilt += POS_FB_LPF_ALPHA * (raw - s_pos.fbFilt); /* 一阶低通 */
  82   2          }
  83   1      
  84   1          s_pos.fb = POS_FB_DIR * (s_pos.fbFilt - POS_FB_ZERO_DEG) * POS_FB_SCALE;   //当前反馈值
  85   1      
  86   1          /* 换算状态报文 raw */
  87   1          rawFb = s_pos.fb / POS_CMD_RES + POS_CMD_ZERO; /* 角度×100 或 百分比×10 */
  88   1          if (rawFb < 0.0f)       { rawFb = 0.0f; }      /* 下限保护 */
